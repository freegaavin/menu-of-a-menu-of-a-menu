-- Takes damage -> card flashes red for ~1s, spawns particles + a floating damage number.
function Library:CreateTargetHUD()
    local T = Library.Theme
    local HURT = Color3.fromRGB(255, 78, 78)        -- only the AVATAR is tinted with this
    local AV_BG = Color3.fromRGB(14, 14, 16)
    local H_CARD = 76
    local AV_X, AV_Y, AV = 13, 14, 48

    -- invisible holder: owns position / anchor / visibility / width
    local card = New("Frame", {
        Name = "TargetHUD", BackgroundTransparency = 1, ZIndex = 100,
        Size = UDim2.new(0, 240, 0, H_CARD), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.62, 0),
        Visible = false, Parent = Root,
    })
    -- the visible card; it scales around its own centre on hit
    local body = New("Frame", {
        Name = "Body", BackgroundColor3 = Color3.fromRGB(30, 30, 34), BackgroundTransparency = 0.04, ZIndex = 100,
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(1, 0, 1, 0), Parent = card,
    })
    Corner(body, 14)
    Shadow(body, 14, { Spread = 12, Offset = 3, Strength = 0.4 })
    local pop = New("UIScale", { Scale = 1, Parent = body })

    local avatar = New("ImageLabel", {
        BackgroundColor3 = AV_BG, Image = "", ImageColor3 = WHITE,
        Position = UDim2.new(0, AV_X, 0, AV_Y), Size = UDim2.new(0, AV, 0, AV), Parent = body,
    })
    Corner(avatar, 11)
    local nameL = Text(body, "", {
        Position = UDim2.new(0, 76, 0, 18), SizeUDim = UDim2.new(0, 110, 0, 24), Size = 14, Font = F_SEMI,
        Truncate = Enum.TextTruncate.AtEnd,
    })
    local hpL = Text(body, "100", {
        Position = UDim2.new(1, -14, 0, 18), AnchorPoint = Vector2.new(1, 0), SizeUDim = UDim2.new(0, 44, 0, 24),
        AlignX = TRIGHT, Size = 14, Font = F_BOLD,
    })
    local track = New("Frame", {
        BackgroundColor3 = Color3.fromRGB(62, 62, 68), Position = UDim2.new(0, 76, 0, 47), Size = UDim2.new(1, -90, 0, 9), Parent = body,
    })
    Corner(track, 5)
    -- soft "recent damage" trail; only visible while the bar is catching down
    local trail = New("Frame", {
        BackgroundColor3 = Color3.fromRGB(190, 190, 198), BackgroundTransparency = 0.55, Size = UDim2.new(1, 0, 1, 0),
        Visible = false, Parent = track,
    })
    Corner(trail, 5)
    local fill = New("Frame", { BackgroundColor3 = WHITE, Size = UDim2.new(1, 0, 1, 0), Parent = track })
    Corner(fill, 5)
    AccentGradient(fill, 0.4)

    local target, hum, hpConn, charConn = nil, nil, nil, nil
    local lastHealth, hitId, trailId, restoreId = 100, 0, 0, 0
    local shownFrac, shownHp, shownMax = 1, 100, 100
    local followActive, fixedPos = false, card.Position
    local cycleIdx = 0
    local avTween

    -- the card grows with long names (min 240 wide like the real one)
    local function resize()
        local nameW = TextW(nameL.Text, 14, F_SEMI)
        local w = math.clamp(nameW + 134, 240, 420)
        card.Size = UDim2.new(0, w, 0, H_CARD)
        nameL.Size = UDim2.new(0, w - 130, 0, 24)
    end

    -- particles spray out of the AVATAR
    local function burst()
        local rng = Random.new()
        local cx, cy = AV_X + AV / 2, AV_Y + AV / 2
        for _ = 1, 18 do
            local sz = rng:NextInteger(3, 6)
            local ang = rng:NextNumber() * math.pi * 2
            local dist = rng:NextNumber(26, 64)
            local white = rng:NextNumber() < 0.25
            local pt = New("Frame", {
                BackgroundColor3 = white and Color3.fromRGB(255, 226, 226)
                    or Color3.fromRGB(255, rng:NextInteger(60, 110), rng:NextInteger(60, 100)),
                BorderSizePixel = 0, Size = UDim2.new(0, sz, 0, sz), AnchorPoint = Vector2.new(0.5, 0.5),
                Rotation = rng:NextInteger(0, 90),
                Position = UDim2.new(0, cx + math.cos(ang) * 14, 0, cy + math.sin(ang) * 14), ZIndex = 20, Parent = body,
            })
            Corner(pt, 2)
            local life = 0.45 + rng:NextNumber() * 0.45
            Tween(pt, {
                Position = UDim2.new(0, cx + math.cos(ang) * dist, 0, cy + math.sin(ang) * dist + 16), -- slight fall
                BackgroundTransparency = 1, Size = UDim2.new(0, 1, 0, 1), Rotation = pt.Rotation + rng:NextInteger(-200, 200),
            }, life, Enum.EasingStyle.Quad)
            Debris:AddItem(pt, life + 0.2)
        end
    end

    -- hit reaction: whole card shrinks a touch and springs back; ONLY the avatar goes red + shakes + sprays particles
    local function hit()
        hitId += 1
        local id = hitId
        Tween(pop, { Scale = 0.93 }, 0.05, Enum.EasingStyle.Quad)
        task.delay(0.05, function()
            if Library.Dead or id ~= hitId then return end
            Tween(pop, { Scale = 1 }, 0.45, Enum.EasingStyle.Back) -- Back easing overshoots slightly = springy
        end)

        if avTween then avTween:Cancel() end
        avatar.ImageColor3 = HURT
        avatar.BackgroundColor3 = Color3.fromRGB(70, 14, 18)
        task.delay(0.14, function()
            if Library.Dead or id ~= hitId then return end
            avTween = Tween(avatar, { ImageColor3 = WHITE, BackgroundColor3 = AV_BG }, 0.55, Enum.EasingStyle.Quad)
        end)
        task.spawn(function()
            for _, dx in ipairs({ -3, 3, -2, 2, -1, 0 }) do
                if Library.Dead or id ~= hitId then return end
                avatar.Position = UDim2.new(0, AV_X + dx, 0, AV_Y)
                task.wait(0.03)
            end
        end)
        burst()
    end

    local function setHealth(hp, max)
        max = (max and max > 0) and max or 100
        shownHp, shownMax = hp, max
        local f = math.clamp(hp / max, 0, 1)
        hpL.Text = tostring(math.floor(hp + 0.5))
        Tween(fill, { Size = UDim2.new(f, 0, 1, 0) }, 0.2)
        trailId += 1
        local tid = trailId
        if f >= shownFrac then
            trail.Visible = false
            trail.Size = UDim2.new(f, 0, 1, 0)
        else
            if not trail.Visible then trail.Size = UDim2.new(shownFrac, 0, 1, 0) end
            trail.Visible = true
            task.delay(0.35, function()
                if Library.Dead or tid ~= trailId or not trail.Parent then return end
                local tw = Tween(trail, { Size = UDim2.new(f, 0, 1, 0) }, 0.3)
                tw.Completed:Connect(function() if tid == trailId then trail.Visible = false end end)
            end)
        end
        shownFrac = f
    end

    -- amount optional; simulate = true also drops the displayed health for a moment (used for the click/test preview)
    Library.TargetHit = function(amount, simulate)
        amount = amount or math.random(8, 24)
        hit()
        if simulate then
            setHealth(math.max(0, shownHp - amount), shownMax)
            restoreId += 1
            local rid = restoreId
            task.delay(2.2, function()
                if Library.Dead or rid ~= restoreId then return end
                if hum and hum.Parent then setHealth(hum.Health, hum.MaxHealth) else setHealth(shownMax, shownMax) end
            end)
        end
    end

    local function bindHumanoid(h)
        if hpConn then hpConn:Disconnect() hpConn = nil end
        hum = h
        if not h then setHealth(0, 100) return end
        lastHealth = h.Health
        setHealth(h.Health, h.MaxHealth)
        hpConn = h.HealthChanged:Connect(function(hp)
            setHealth(hp, h.MaxHealth)
            if hp < lastHealth then hit() end
            lastHealth = hp
        end)
    end

    local function bindPlayer(plr)
        if charConn then charConn:Disconnect() charConn = nil end
        target = plr
        if not plr then bindHumanoid(nil) return end
        nameL.Text = plr.Name .. ((plr.DisplayName ~= plr.Name) and (" <font color='rgb(140,140,148)'>(" .. plr.DisplayName .. ")</font>") or "")
        resize()
        avatar.Image = ""
        task.spawn(function()
            local ok, img = pcall(Players.GetUserThumbnailAsync, Players, plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
            if ok and img and target == plr and avatar.Parent then avatar.Image = img end
        end)
        local ch = plr.Character
        bindHumanoid(ch and ch:FindFirstChildOfClass("Humanoid"))
        charConn = plr.CharacterAdded:Connect(function(c)
            bindHumanoid(c:WaitForChild("Humanoid", 5))
        end)
    end

    function Library.RefreshTargetHud()
        local want = Library.Target or (Library.TargetHudOn and LocalPlayer or nil)
        if want ~= target then bindPlayer(want) end
        card.Visible = Library.TargetHudOn and target ~= nil
    end
    function Library:SetTarget(plr)
        Library.Target = plr
        Library.RefreshTargetHud()
    end
    function Library:SetTargetHud(on)
        Library.TargetHudOn = on
        Library.RefreshTargetHud()
        if on then Shine(card, 16, 0.6) end
    end
    function Library:SetTargetFollow(on)
        Library.TargetFollow = on
    end
    function Library:CycleTarget()
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then list[#list + 1] = p end
        end
        if #list == 0 then
            Library:SetTarget(nil)
            Library:Notify("Target HUD", "No other players in the server - previewing yourself", 3)
            return
        end
        cycleIdx = (cycleIdx % #list) + 1
        Library:SetTarget(list[cycleIdx])
    end
    Track(Players.PlayerRemoving:Connect(function(p)
        if Library.Target == p then Library:SetTarget(nil) end
    end))

    local function restoreFixed()
        followActive = false
        card.AnchorPoint = Vector2.new(0.5, 0)
        card.Position = fixedPos
        card.Visible = Library.TargetHudOn and target ~= nil
    end

    -- auto-target the nearest player
    local nearAcc = 0
    function Library:SetTargetNearest(on)
        Library.TargetNearest = on and true or false
        if on then nearAcc = 1 end -- pick one immediately
    end
    Track(RunService.Heartbeat:Connect(function(dt)
        if not Library.TargetNearest then return end
        nearAcc += dt
        if nearAcc < 0.2 then return end
        nearAcc = 0
        local mine = LocalPlayer.Character
        local myRoot = mine and mine:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local best, bd, curD = nil, math.huge, nil
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LocalPlayer then
                local c = pl.Character
                local r = c and c:FindFirstChild("HumanoidRootPart")
                local h = c and c:FindFirstChildOfClass("Humanoid")
                if r and h and h.Health > 0 then
                    local d = (r.Position - myRoot.Position).Magnitude
                    if d < bd then best, bd = pl, d end
                    if pl == Library.Target then curD = d end
                end
            end
        end
        -- small hysteresis so two players at similar distance don't make the card flicker between them
        if best and best ~= Library.Target and curD and bd > curD - 3 then best = Library.Target end
        if best ~= Library.Target then Library:SetTarget(best) end
    end))

    -- follow mode: card sits BESIDE the target, flips sides near screen edges
    local sideRight, lastSide = true, nil
    Track(RunService.RenderStepped:Connect(function(dt)
        if not followActive then fixedPos = card.Position end
        local want = Library.TargetHudOn and target ~= nil
        local follow = want and Library.TargetFollow and target ~= LocalPlayer
        if followActive and not follow then restoreFixed() lastSide = nil end
        if not follow then return end

        local ch = target.Character
        local root = ch and (ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso"))
        local cam = workspace.CurrentCamera
        local goalX, goalY
        if root and cam then
            local sc = Library.Scale
            local c, on = cam:WorldToViewportPoint(root.Position)
            if on and c.Z > 0 then
                local r = cam:WorldToViewportPoint(root.Position + cam.CFrame.RightVector * 2.6)
                local off = math.max(math.abs(r.X - c.X) / sc, 34) -- px from the body centre to the card edge
                local cx, cardW, vpx = c.X / sc, card.AbsoluteSize.X / sc, Viewport().X
                local rightFits = cx + off + 8 + cardW <= vpx
                local leftFits = cx - off - 8 - cardW >= 0
                if sideRight and not rightFits and leftFits then sideRight = false
                elseif not sideRight and not leftFits and rightFits then sideRight = true end
                goalX = sideRight and (cx + off + 8) or (cx - off - 8)
                goalY = c.Y / sc
            end
        end

        if not followActive then followActive = true; lastSide = nil end
        if goalX then
            local goal = UDim2.new(0, goalX, 0, goalY)
            if lastSide ~= sideRight then
                lastSide = sideRight
                card.AnchorPoint = sideRight and Vector2.new(0, 0.5) or Vector2.new(1, 0.5)
                card.Position = goal
            end
            card.Visible = true
            card.Position = card.Position:Lerp(goal, 1 - math.exp(-dt * 22))
        else
            card.Visible = false
        end
    end))

    -- click the card = fake damage (just to show the hit animation)
    local downAt
    body.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            downAt = Vector2.new(i.Position.X, i.Position.Y)
        end
    end)
    Track(UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 and downAt then
            local up = Vector2.new(i.Position.X, i.Position.Y)
            local wasClick = (up - downAt).Magnitude < 5 -- a drag doesn't count
            downAt = nil
            if wasClick and card.Visible then Library.TargetHit(nil, true) end
        end
    end))

    MakeDraggable(body, card, function() return not followActive end)
    Library.Widgets.TargetHUD = card
    return card
end

-- ESP preview (spinning 3D noob)
-- Library:CreateESPPreview(tab, { Page = "Players", Prefix = "Visuals" })
-- Draws a spinning dummy and mirrors your ESP settings live. It reads these flags (Prefix defaults to the tab name):
--   <Prefix>.ESP/Enabled  ESP/Outline  Box/Enabled  Box/Fill Box  Name/Enabled  Name/Type  Health/Health Bar  Health/Health Based
--   Health/Health Text  Indicators/Distance  Equipped Item  Skeleton  Head Dot  Head Dot Glow  Chams/Enabled  Chams/Filled
--   Tracer/Enabled  Tracer/Origin     and colour flags BoxColor NameColor HealthColor DistanceColor ItemColor SkeletonColor
--   HeadDotColor ChamsColor TracerColor.   (use a Single = true page so the right half of the window is free for it)
function Library:CreateESPPreview(tab, popts)
    popts = popts or {}
    local T = Library.Theme
    local PFX = popts.Prefix or tab.Name
    local panel, body, pillBtn = tab:AddSidePanel({ Title = "ESP", Subtitle = "Preview", Pill = "3D", Page = popts.Page })

    local view = New("ViewportFrame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
        Ambient = Color3.fromRGB(165, 165, 165), LightColor = Color3.fromRGB(255, 255, 255),
        LightDirection = Vector3.new(-0.6, -1, -0.8), Parent = body,
    })
    local yellow, blue, green = Color3.fromRGB(245, 205, 48), Color3.fromRGB(13, 105, 172), Color3.fromRGB(164, 189, 71)
    local model = Instance.new("Model")
    local originals = {}
    local function part(name, size, pos, color)
        local p = Instance.new("Part")
        p.Name, p.Size, p.Position, p.Color = name, size, pos, color
        p.Anchored, p.Material = true, Enum.Material.SmoothPlastic
        p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
        p.Parent = model
        originals[p] = color
        return p
    end
    local head = part("Head", Vector3.new(2, 1, 1), Vector3.new(0, 4.5, 0), yellow)
    local hm = Instance.new("SpecialMesh")
    hm.MeshType, hm.Scale = Enum.MeshType.Head, Vector3.new(1.25, 1.25, 1.25)
    hm.Parent = head
    pcall(function()
        local face = Instance.new("Decal")
        face.Texture, face.Face = "rbxasset://textures/face.png", Enum.NormalId.Front
        face.Parent = head
    end)
    local torso = part("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), blue)
    part("LeftArm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 3, 0), yellow)
    part("RightArm", Vector3.new(1, 2, 1), Vector3.new(1.5, 3, 0), yellow)
    part("LeftLeg", Vector3.new(1, 2, 1), Vector3.new(-0.5, 1, 0), green)
    part("RightLeg", Vector3.new(1, 2, 1), Vector3.new(0.5, 1, 0), green)
    model.PrimaryPart = torso
    model.Parent = view

    local DIST = 10.5
    local cam = Instance.new("Camera")
    cam.FieldOfView = 40
    cam.CFrame = CFrame.lookAt(Vector3.new(0, 3, DIST), Vector3.new(0, 3, 0))
    cam.Parent = view
    view.CurrentCamera = cam

    -- 2D overlay drawn on top of the 3D view
    local ov = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 5, Parent = body })
    local function frame(props)
        props.ZIndex = 6
        props.BorderSizePixel = 0
        props.Parent = ov
        return New("Frame", props)
    end
    local function label(size, font)
        return New("TextLabel", {
            BackgroundTransparency = 1, TextSize = size, FontFace = font or F_SEMI, RichText = true, TextColor3 = WHITE,
            Size = UDim2.new(0, 160, 0, 14), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 7, Visible = false, Parent = ov,
        })
    end
    local function line() return frame({ AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = WHITE, Size = UDim2.new(0, 0, 0, 1), Visible = false }) end

    local boxF = frame({ BackgroundColor3 = WHITE, BackgroundTransparency = 1, Visible = false })
    local boxS = Stroke(boxF, 0, WHITE)
    boxS.Thickness = 1.5
    local hpTrack = frame({ BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, Visible = false })
    local hpFill = frame({ BackgroundColor3 = Color3.new(0, 1, 0), AnchorPoint = Vector2.new(0, 1), Visible = false })
    local nameL, distL, itemL, hpText = label(11), label(10, F_MED), label(10, F_MED), label(9, F_BOLD)
    local skel = {}
    for i = 1, 9 do skel[i] = line() end
    local tracer = line()
    local dot = frame({ AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = WHITE, Size = UDim2.new(0, 7, 0, 7), Visible = false })
    Corner(dot, 4)
    -- head dot glow: slightly smaller halo (15px, was 20px)
    local glow = frame({ AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = WHITE, BackgroundTransparency = 0.7, Size = UDim2.new(0, 15, 0, 15), Visible = false })
    Corner(glow, 8)

    local function setLine(l, a, b, color, th, vis)
        l.Visible = vis
        if not vis then return end
        local d = b - a
        l.Position = UDim2.new(0, (a.X + b.X) / 2, 0, (a.Y + b.Y) / 2)
        l.Size = UDim2.new(0, d.Magnitude, 0, th)
        l.Rotation = math.deg(math.atan2(d.Y, d.X))
        l.BackgroundColor3 = color
    end

    local angle, t, spin = math.pi, 0, true
    if pillBtn then
        pillBtn.MouseButton1Click:Connect(function()
            spin = not spin
            pillBtn.Text = spin and "3D" or "2D"
            if not spin then angle = math.pi end
        end)
    end

    local pconn
    pconn = Track(RunService.RenderStepped:Connect(function(dt)
        if not panel.Parent then pconn:Disconnect() return end
        if not panel.Visible then return end
        t += dt
        if spin then angle += dt * 0.9 end
        model:PivotTo(CFrame.new(0, 3, 0) * CFrame.Angles(0, angle, 0))

        local sz = body.AbsoluteSize / Library.Scale
        local W, Hh = sz.X, sz.Y
        local ppu = Hh / (2 * DIST * math.tan(math.rad(20)))
        local ca = math.cos(angle - math.pi)
        local function P(x, y) return Vector2.new(W / 2 + x * ca * ppu, Hh / 2 - (y - 3) * ppu) end

        local F = Library.Flags
        local on = F[PFX .. ".ESP/Enabled"] and true or false
        local function col(key, default) return F[key] or default or WHITE end
        local function tr(key) return 1 - (F[key .. "_Alpha"] or 1) end -- picker transparency (0 = solid)

        -- chams
        local ch = on and F[PFX .. ".Chams/Enabled"]
        for p, orig in pairs(originals) do
            p.Color = ch and col("ChamsColor") or orig
            local base = ch and (F[PFX .. ".Chams/Filled"] and 0.1 or 0.6) or 0
            p.Transparency = base + (1 - base) * (ch and tr("ChamsColor") or 0)
        end

        -- box
        local top, bottom = Hh / 2 - (5.45 - 3) * ppu, Hh / 2 + 3 * ppu
        local halfW = 1.3 * ppu
        local boxOn = on and F[PFX .. ".Box/Enabled"]
        boxF.Visible = boxOn and true or false
        if boxOn then
            boxF.Position = UDim2.new(0, W / 2 - halfW, 0, top)
            boxF.Size = UDim2.new(0, halfW * 2, 0, bottom - top)
            boxS.Color = col("BoxColor")
            boxF.BackgroundColor3 = col("BoxColor")
            boxS.Transparency = tr("BoxColor")
            boxF.BackgroundTransparency = F[PFX .. ".Box/Fill Box"] and (1 - 0.18 * (1 - tr("BoxColor"))) or 1
        end

        local outline = F[PFX .. ".ESP/Outline"] and 0.3 or 1
        -- name
        local nameOn = on and F[PFX .. ".Name/Enabled"]
        nameL.Visible = nameOn and true or false
        if nameOn then
            nameL.Position = UDim2.new(0, W / 2, 0, top - 10)
            nameL.Text = (F[PFX .. ".Name/Type"] == "Display") and LocalPlayer.DisplayName or LocalPlayer.Name
            nameL.TextColor3 = col("NameColor")
            nameL.TextTransparency = tr("NameColor")
            nameL.TextStrokeTransparency = math.max(outline, tr("NameColor"))
        end
        -- health
        local hp = 0.675 + 0.325 * math.sin(t * 0.9)
        local hpOn = on and F[PFX .. ".Health/Health Bar"]
        hpTrack.Visible, hpFill.Visible = hpOn and true or false, hpOn and true or false
        if hpOn then
            local x = W / 2 - halfW - 7
            hpTrack.Position = UDim2.new(0, x - 1, 0, top - 1)
            hpTrack.Size = UDim2.new(0, 4, 0, bottom - top + 2)
            hpFill.Position = UDim2.new(0, x, 0, bottom)
            hpFill.Size = UDim2.new(0, 2, 0, (bottom - top) * hp)
            hpFill.BackgroundTransparency = tr("HealthColor")
            hpFill.BackgroundColor3 = F[PFX .. ".Health/Health Based"] and Color3.fromHSV(hp * 0.33, 1, 1) or col("HealthColor", Color3.new(0, 1, 0))
        end
        local htOn = on and F[PFX .. ".Health/Health Text"]
        hpText.Visible = htOn and true or false
        if htOn then
            hpText.Position = UDim2.new(0, W / 2 - halfW - 18, 0, bottom - (bottom - top) * hp)
            hpText.Text = tostring(math.floor(hp * 100))
            hpText.TextStrokeTransparency = outline
        end
        -- distance / item
        local dOn = on and F[PFX .. ".Indicators/Distance"]
        distL.Visible = dOn and true or false
        if dOn then
            distL.Position = UDim2.new(0, W / 2, 0, bottom + 9)
            distL.Text = "[ 24m ]"
            distL.TextColor3 = col("DistanceColor")
            distL.TextTransparency = tr("DistanceColor")
            distL.TextStrokeTransparency = math.max(outline, tr("DistanceColor"))
        end
        local iOn = on and F[PFX .. ".Indicators/Equipped Item"]
        itemL.Visible = iOn and true or false
        if iOn then
            itemL.Position = UDim2.new(0, W / 2, 0, bottom + (dOn and 21 or 9))
            itemL.Text = "Linked Sword"
            itemL.TextColor3 = col("ItemColor")
            itemL.TextTransparency = tr("ItemColor")
            itemL.TextStrokeTransparency = math.max(outline, tr("ItemColor"))
        end
        -- skeleton (follows the spin)
        local sOn = on and F[PFX .. ".Indicators/Skeleton"]
        local sc = col("SkeletonColor")
        local neck, pelvis = P(0, 4.0), P(0, 2.0)
        local shL, shR = P(-1.0, 3.8), P(1.0, 3.8)
        local hdL, hdR = P(-1.5, 2.2), P(1.5, 2.2)
        local knL, knR, ftL, ftR = P(-0.5, 1), P(0.5, 1), P(-0.5, 0), P(0.5, 0)
        setLine(skel[1], P(0, 4.6), neck, sc, 1.5, sOn and true or false)
        setLine(skel[2], neck, pelvis, sc, 1.5, sOn and true or false)
        setLine(skel[3], shL, shR, sc, 1.5, sOn and true or false)
        setLine(skel[4], shL, hdL, sc, 1.5, sOn and true or false)
        setLine(skel[5], shR, hdR, sc, 1.5, sOn and true or false)
        setLine(skel[6], pelvis, knL, sc, 1.5, sOn and true or false)
        setLine(skel[7], knL, ftL, sc, 1.5, sOn and true or false)
        setLine(skel[8], pelvis, knR, sc, 1.5, sOn and true or false)
        setLine(skel[9], knR, ftR, sc, 1.5, sOn and true or false)
        local sa = tr("SkeletonColor")
        for _, l in ipairs(skel) do l.BackgroundTransparency = sa end
        -- head dot
        local hdOn = on and F[PFX .. ".Indicators/Head Dot"]
        dot.Visible = hdOn and true or false
        glow.Visible = (hdOn and F[PFX .. ".Indicators/Head Dot Glow"]) and true or false
        if hdOn then
            local hp2 = P(0, 4.5)
            dot.Position = UDim2.new(0, hp2.X, 0, hp2.Y)
            dot.BackgroundTransparency = tr("HeadDotColor")
            glow.BackgroundTransparency = 1 - 0.3 * (1 - tr("HeadDotColor"))
            dot.BackgroundColor3 = col("HeadDotColor")
            glow.Position = dot.Position
            glow.BackgroundColor3 = col("HeadDotColor")
        end
        -- tracer
        local trOn = on and F[PFX .. ".Tracer/Enabled"]
        local origin = F[PFX .. ".Tracer/Origin"] or "Top"
        local oy = (origin == "Bottom") and Hh or ((origin == "Center") and Hh / 2 or 0)
        setLine(tracer, Vector2.new(W / 2, oy), Vector2.new(W / 2, bottom), col("TracerColor"), 1, trOn and true or false)
        tracer.BackgroundTransparency = tr("TracerColor")
    end))

    -- collapse to the side: the preview shrinks to a thin strip on the right edge and the settings widen to fill the page.
    -- Click the "PREVIEW" header (chevron points right) to collapse, click the strip (chevron points left) to bring it back.
    do
        local pg = tab:GetPage(popts.Page)
        local sf = pg and pg.Grp and pg.Grp:FindFirstChildOfClass("ScrollingFrame")
        local fullPos, fullSize = panel.Position, panel.Size
        local STRIP = 34
        local collapsed = false
        local head = panel:FindFirstChildOfClass("TextLabel")

        local chev = Chevron(panel, UDim2.new(0, 88, 0, 15), T.TextDim)
        chev.Rotation = -90 -- points right: "push to the side"
        local hit = New("TextButton", {
            Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
            Size = UDim2.new(0, 104, 0, 30), ZIndex = 5, Parent = panel,
        })

        -- the collapsed strip
        local strip = New("TextButton", {
            Text = "", AutoButtonColor = false, BackgroundColor3 = T.Section, BackgroundTransparency = 0.5,
            Size = UDim2.new(1, 0, 1, -4), Visible = false, ZIndex = 5, Parent = panel,
        })
        Corner(strip, 10); Stroke(strip, 0.9)
        local schev = Chevron(strip, UDim2.new(0.5, 0, 0, 22), T.TextDim)
        schev.Rotation = 90 -- points left: "bring it back"
        local sText = New("TextLabel", {
            BackgroundTransparency = 1, Text = "PREVIEW", TextColor3 = T.TextDim, TextSize = 10, FontFace = F_SEMI,
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 90, 0, 14),
            Rotation = 90, Parent = strip,
        })

        local function hover(btn, targets, normalBg)
            btn.MouseEnter:Connect(function()
                for _, c in ipairs(targets) do
                    if c:IsA("Frame") then Tween(c, { BackgroundColor3 = T.Text }, 0.1) end
                    if c:IsA("TextLabel") then Tween(c, { TextColor3 = T.Text }, 0.1) end
                end
                if normalBg then Tween(btn, { BackgroundTransparency = 0.3 }, 0.1) end
            end)
            btn.MouseLeave:Connect(function()
                for _, c in ipairs(targets) do
                    if c:IsA("Frame") then Tween(c, { BackgroundColor3 = T.TextDim }, 0.1) end
                    if c:IsA("TextLabel") then Tween(c, { TextColor3 = T.TextDim }, 0.1) end
                end
                if normalBg then Tween(btn, { BackgroundTransparency = 0.5 }, 0.1) end
            end)
        end
        hover(hit, chev:GetChildren(), false)
        local sTargets = { sText }
        for _, c in ipairs(schev:GetChildren()) do sTargets[#sTargets + 1] = c end
        hover(strip, sTargets, true)

        local function setCollapsed(c)
            collapsed = c
            local ti = Enum.EasingStyle.Quint
            if c then
                body.Visible = false
                if head then head.Visible = false end
                chev.Visible, hit.Visible = false, false
                if pillBtn then pillBtn.Visible = false end
                strip.Visible = true
                Tween(panel, { Position = UDim2.new(1, -STRIP, 0, 0), Size = UDim2.new(0, STRIP, fullSize.Y.Scale, fullSize.Y.Offset) }, 0.25, ti)
                if pg then pg.SetLayout(false, true) end -- two balanced columns, sections re-sorted
                if sf then Tween(sf, { Size = UDim2.new(1, -(STRIP + 10), 1, 0) }, 0.25, ti) end
            else
                strip.Visible = false
                Tween(panel, { Position = fullPos, Size = fullSize }, 0.25, ti)
                if pg then pg.SetLayout(true, true) end -- back to one column
                if sf then Tween(sf, { Size = UDim2.new(0.5, -7, 1, 0) }, 0.25, ti) end
                task.delay(0.18, function()
                    if collapsed or not panel.Parent then return end
                    body.Visible = true
                    if head then head.Visible = true end
                    chev.Visible, hit.Visible = true, true
                    if pillBtn then pillBtn.Visible = true end
                end)
            end
        end
        hit.MouseButton1Click:Connect(function() setCollapsed(true) end)
        strip.MouseButton1Click:Connect(function() setCollapsed(false) end)
        Library.ESPPreviewSetCollapsed = setCollapsed
        if popts.Collapsed then setCollapsed(true) end
    end

    Library.Widgets.ESPPreview = panel
    return panel
end

