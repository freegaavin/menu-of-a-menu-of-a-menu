        AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 10, 1, -52), Size = UDim2.new(1, -20, 0, 1), Parent = presets,
    })
    local nameBox = New("TextBox", {
        Text = "", PlaceholderText = "Config name...", PlaceholderColor3 = T.TextDim, ClearTextOnFocus = false,
        BackgroundColor3 = T.Section, BackgroundTransparency = 0.3, TextColor3 = T.Text, TextSize = 12, FontFace = F_MED,
        TextXAlignment = TLEFT, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 10, 1, -10),
        Size = UDim2.new(1, -112, 0, 32), Parent = presets,
    })
    Corner(nameBox, 8); Pad(nameBox, 10, 0, 10, 0); Stroke(nameBox, 0.9)
    local saveBtn = New("TextButton", {
        Text = "Save config", AutoButtonColor = false, BackgroundColor3 = T.Element, BackgroundTransparency = 0.35,
        TextColor3 = T.Text, TextSize = 12, FontFace = F_SEMI, AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -10, 1, -10), Size = UDim2.new(0, 92, 0, 32), Parent = presets,
    })
    Corner(saveBtn, 8); Stroke(saveBtn, 0.85)
    saveBtn.MouseEnter:Connect(function() Tween(saveBtn, { BackgroundTransparency = 0.15 }, 0.1) end)
    saveBtn.MouseLeave:Connect(function() Tween(saveBtn, { BackgroundTransparency = 0.35 }, 0.1) end)
    local saveArmed = false
    local function doSave()
        local nm = nameBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
        if nm == "" then Library:Notify("Configs", "Type a name for the config first", 3) return end
        local exists = false
        for _, n in ipairs(Library:ListConfigs()) do
            if n:lower() == nm:lower() then exists = true break end
        end
        if exists and not saveArmed then -- same name -> ask once before overwriting
            saveArmed = true
            saveBtn.Text = "Overwrite?"
            task.delay(2, function()
                if saveArmed and saveBtn.Parent then saveArmed = false; saveBtn.Text = "Save config" end
            end)
            return
        end
