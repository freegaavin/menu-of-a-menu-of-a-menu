-- Drag pattern for widgets: a slowly scrolling diagonal hatch + soft accent glow inside the drag outline (no logo - that is main-window only).
local function AttachDragPattern(ghost, radius, step)
    step = step or 14
    local group = New("CanvasGroup", {
        Name = "DragPattern", BackgroundTransparency = 1, GroupTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 190, Parent = ghost,
    })
    New("UICorner", { CornerRadius = radius, Parent = group })
    local glow = New("Frame", {
        BackgroundColor3 = Library.Theme.Accent, BorderSizePixel = 0, BackgroundTransparency = 0.82,
        Size = UDim2.new(1, 0, 1, 0), ZIndex = 190, Parent = group,
    })
    New("UIGradient", {
        Rotation = 90, Parent = glow,
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.15) }),
    })
    local stripes = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 190, Parent = group })
    local built
    local P = {}
    function P.Rebuild(w, h)
        if built and built.X == w and built.Y == h then return end
        built = Vector2.new(w, h)
        stripes:ClearAllChildren()
        local len = w + h
        local t, n = -h / 2 - step * 4, 0
        while t <= w + h / 2 + step * 4 do
            n += 1
            New("Frame", {
                BackgroundColor3 = Library.Theme.Accent, BorderSizePixel = 0,
                BackgroundTransparency = (n % 4 == 0) and 0.72 or 0.86,
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(t, h / 2),
                Size = UDim2.fromOffset(len, (n % 4 == 0) and 2 or 1), Rotation = -45, ZIndex = 190, Parent = stripes,
            })
            t += step
        end
    end
    function P.Show()
        glow.BackgroundColor3 = Library.Theme.Accent
        for _, f in ipairs(stripes:GetChildren()) do f.BackgroundColor3 = Library.Theme.Accent end
        Tween(group, { GroupTransparency = 0 }, 0.3)
    end
    function P.Hide() Tween(group, { GroupTransparency = 1 }, 0.35) end
    Track(RunService.Heartbeat:Connect(function()
        if not ghost.Visible then return end
        -- wraps on the 4-line repeat, so the downward scroll never visibly resets
        stripes.Position = UDim2.fromOffset(0, (os.clock() * (step * 0.55)) % (step * 4))
    end))
    return P
end

-- Widget dragging = same look as the main window: an outline follows the cursor, the widget glides over on release.
local function MakeDraggable(handle, target, canDrag, onStart)
    local dragging, pending, start, origin, goal, glide = false, false, nil, nil, nil, nil
    local ghost, ghostScale, ghostStroke, pattern
    local function prep()
        if ghost and ghost.Parent then return end
        local cr = target:FindFirstChildOfClass("UICorner")
        ghost = New("Frame", {
            Name = "DragGhost", BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0,
            Visible = false, ZIndex = 190, Parent = target.Parent,
        })
        New("UICorner", { CornerRadius = cr and cr.CornerRadius or UDim.new(0, 10), Parent = ghost })
        New("UIGradient", {
            Rotation = 90, Parent = ghost,
            Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0.97) }),
        })
        ghostScale = New("UIScale", { Scale = 1, Parent = ghost })
        ghostStroke = Stroke(ghost, 1, WHITE)
        ghostStroke.Thickness = 2
        AccentGradient(ghostStroke, 0.5)
        pattern = AttachDragPattern(ghost, cr and cr.CornerRadius or UDim.new(0, 10), 14)
    end
    local function begin()
        dragging = true
        prep()
        local sc = Library.Scale
        ghost.AnchorPoint = target.AnchorPoint
        ghost.Size = UDim2.new(0, target.AbsoluteSize.X / sc, 0, target.AbsoluteSize.Y / sc)
        ghost.Position = target.Position
        ghost.Visible = true
        pattern.Rebuild(target.AbsoluteSize.X / sc, target.AbsoluteSize.Y / sc)
        pattern.Show()
        ghostScale.Scale = 0.985
        Tween(ghostScale, { Scale = 1 }, 0.35, Enum.EasingStyle.Quint)
        Tween(ghostStroke, { Transparency = 0.05 }, 0.15)
        Tween(ghost, { BackgroundTransparency = 0 }, 0.15)
        if onStart then onStart() end
    end
    handle.InputBegan:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if Library.WindowDragging or Library.ElementDragging then return end
        if canDrag and not canDrag() then return end
        if glide then glide:Cancel() glide = nil end
        pending = true
        start, origin = Vector2.new(i.Position.X, i.Position.Y), target.Position
        goal = origin
    end)
    Track(UIS.InputChanged:Connect(function(i)
        if (pending or dragging) and i.UserInputType == Enum.UserInputType.MouseMovement then
            local cur = Vector2.new(i.Position.X, i.Position.Y)
            if pending and (cur - start).Magnitude >= 4 then
                pending = false
                begin()
            end
            if dragging then
                local d = (cur - start) / Library.Scale
                goal = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
            end
        end
    end))
    Track(RunService.RenderStepped:Connect(function(dt)
        if dragging and goal then ghost.Position = ghost.Position:Lerp(goal, 1 - math.exp(-dt * 24)) end
    end))
    Track(UIS.InputEnded:Connect(function(i)
        if (pending or dragging) and i.UserInputType == Enum.UserInputType.MouseButton1 then
            pending = false
            if not dragging then return end
            dragging = false
            glide = Tween(target, { Position = goal }, 0.6, Enum.EasingStyle.Quint)
            Tween(ghost, { Position = goal, BackgroundTransparency = 1 }, 0.5, Enum.EasingStyle.Quint)
            Tween(ghostStroke, { Transparency = 1 }, 0.45)
            pattern.Hide()
            task.delay(0.55, function()
                if not dragging and ghost then ghost.Visible = false end
            end)
        end
    end))
end

-- shadows
-- Soft drop shadows built from stacked FILLED rounded rects. Each layer's alpha is solved so the
-- combined darkness in every ring follows a smooth falloff. (The old version used hollow stroked rings,
-- which left visible hairline seams - "lines" - around every widget.)
local Shadows = {}

local function Falloff(j, N) -- 1 at the edge -> 0 at the outer limit (smoothstep)
    local t = math.clamp((j - 1) / N, 0, 1)
    return 1 - t * t * (3 - 2 * t)
end

-- alpha of layer j (1 = innermost) so the cumulative darkness in ring j equals S * Falloff(j)
local function LayerAlpha(j, N, S)
    local a1 = S * Falloff(j, N)
    local a2 = S * Falloff(j + 1, N)
    return math.clamp(1 - (1 - a1) / (1 - a2), 0, 1)
end

-- opts: Spread (px of falloff), Offset (px downward), Strength (0..1), Color (default black)
-- The shadow lives in Root, follows its target every frame, hides with it and fades with its transparency.
local function Shadow(target, radius, opts)
    opts = opts or {}
    local spread = opts.Spread or 12
    local N = math.clamp(math.floor(spread * 1.6), 10, 26)
    local step = spread / N
    local dy = opts.Offset or 3
    local holder = New("Frame", {
        Name = "Shadow", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(),
        Visible = false, ZIndex = 1, Parent = Root,
    })
    local layers = {}
    for j = 1, N do
        local e = j * step
        layers[j] = New("Frame", {
            BackgroundColor3 = opts.Color or Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
            Position = UDim2.new(0, -e, 0, -e + dy), Size = UDim2.new(1, e * 2, 1, e * 2), Parent = holder,
        })
        New("UICorner", { CornerRadius = UDim.new(0, (radius or 8) + e), Parent = layers[j] })
    end
    Shadows[#Shadows + 1] = { Target = target, Holder = holder, Layers = layers, N = N, Strength = opts.Strength or 0.4, F = -1 }
    return holder
end

-- Same look for the big window: it mirrors the target through property signals (no per-frame lag while dragging/resizing).
local function ShadowFill(target, radius, opts)
    opts = opts or {}
    local spread, S, dy = opts.Spread or 18, opts.Strength or 0.5, opts.Offset or 4
    local N = 40
    local step = spread / N
    local holder = New("Frame", {
        Name = "ShadowFill", BackgroundTransparency = 1, BorderSizePixel = 0,
        AnchorPoint = target.AnchorPoint, Position = target.Position, Size = target.Size,
        Visible = target.Visible, ZIndex = math.max(target.ZIndex - 1, 1), Parent = Root,
    })
    for j = 1, N do
        local e = j * step
        local layer = New("Frame", {
            BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1 - LayerAlpha(j, N, S),
            BorderSizePixel = 0, Position = UDim2.new(0, -e, 0, -e + dy), Size = UDim2.new(1, e * 2, 1, e * 2),
            Parent = holder,
        })
        New("UICorner", { CornerRadius = UDim.new(0, (radius or 8) + e), Parent = layer })
    end
    local function sync()
        holder.AnchorPoint = target.AnchorPoint
        holder.Position = target.Position
        holder.Size = target.Size
        holder.Visible = target.Visible
        holder.ZIndex = math.max(target.ZIndex - 1, 1)
    end
    for _, prop in ipairs({ "Position", "Size", "AnchorPoint", "Visible", "ZIndex" }) do
        target:GetPropertyChangedSignal(prop):Connect(sync)
    end
    target.Destroying:Connect(function() holder:Destroy() end)
    return holder
end

Track(RunService.RenderStepped:Connect(function()
    local sc = Library.Scale
    for i = #Shadows, 1, -1 do
        local s = Shadows[i]
        local t, h = s.Target, s.Holder
        if not t or not h.Parent or not t:IsDescendantOf(Root) then
            h:Destroy()
            table.remove(Shadows, i)
        else
            local cur, top, vis = t, t, true
            while cur and cur ~= Root do
                if cur:IsA("GuiObject") and not cur.Visible then vis = false end
                top = cur
                cur = cur.Parent
            end
            local size = t.AbsoluteSize / sc
            if size.X < 2 or size.Y < 2 then vis = false end
            local f = vis and math.clamp(1 - t.BackgroundTransparency, 0, 1) or 0
            if f > 0 and t:IsA("CanvasGroup") then f = f * (1 - t.GroupTransparency) end
            if f < 0.03 then
                if h.Visible then h.Visible = false end
                s.F = -1
            else
                if not h.Visible then h.Visible = true end
                local p = (t.AbsolutePosition - Root.AbsolutePosition) / sc
                local pos = UDim2.new(0, p.X, 0, p.Y)
                if h.Position ~= pos then h.Position = pos end
                local sz = UDim2.new(0, size.X, 0, size.Y)
                if h.Size ~= sz then h.Size = sz end
                local z = math.max(top.ZIndex - 1, 1)
                if h.ZIndex ~= z then h.ZIndex = z end
                if math.abs(f - s.F) > 0.015 then
                    s.F = f
                    for j, layer in ipairs(s.Layers) do
                        layer.BackgroundTransparency = 1 - LayerAlpha(j, s.N, s.Strength * f)
                    end
                end
            end
        end
    end
end))

-- shine / pop
-- Bright sweep across a rounded element.
-- IMPORTANT: if the target is driven by a UIListLayout/AutomaticSize, a scale-sized child would be
-- laid out as a real child and corrupt the layout, so in that case the sweep is drawn as a
-- free-floating overlay on the root instead.
local function SweepOverlay(parent, radius, strength, z)
    local o = New("Frame", {
        BackgroundColor3 = WHITE, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), ZIndex = z, Parent = parent,
    })
    if radius then Corner(o, radius) end
    local g = New("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, strength or 0.78), NumberSequenceKeypoint.new(1, 1),
        }),
        Rotation = 20, Offset = Vector2.new(-1, 0), Parent = o,
    })
    Tween(g, { Offset = Vector2.new(1, 0) }, 0.5, Enum.EasingStyle.Quad)
    Debris:AddItem(o, 0.6)
    return o
end

local function Shine(target, radius, strength)
    if not target or not target.Parent then return end
    local layoutDriven = target.AutomaticSize ~= Enum.AutomaticSize.None
        or target:FindFirstChildOfClass("UIListLayout") ~= nil
        or target:FindFirstChildOfClass("UIGridLayout") ~= nil
    if not layoutDriven then
        SweepOverlay(target, radius, strength, target.ZIndex + 3)
        return
    end
    task.spawn(function()
        RunService.Heartbeat:Wait()
        if Library.Dead or not target.Parent then return end
        local size = target.AbsoluteSize
        if size.X < 2 or size.Y < 2 then return end
        local o = SweepOverlay(Root, radius, strength, 320)
        local sc = Library.Scale
        local rp = target.AbsolutePosition - Root.AbsolutePosition
        o.Position = UDim2.new(0, rp.X / sc, 0, rp.Y / sc)
        o.Size = UDim2.new(0, size.X / sc, 0, size.Y / sc)
    end)
end

local function Pop(o, size)
    o.Size = UDim2.new(0, size - 7, 0, size - 7)
    Tween(o, { Size = UDim2.new(0, size, 0, size) }, 0.3, Enum.EasingStyle.Back)
end

-- show/hide with a slide that can never drift, even if toggled rapidly
local RevealState = setmetatable({}, { __mode = "k" })
local function Reveal(frame, v, dy)
    local st = RevealState[frame]
    if not st then st = {}; RevealState[frame] = st end
    if st.Tween then
        st.Tween:Cancel()
        st.Tween = nil
        if st.Rest then frame.Position = st.Rest end
    end
    if v then
        if frame.Visible then return end
        st.Rest = frame.Position
        frame.Position = st.Rest + UDim2.new(0, 0, 0, dy or 14)
        frame.Visible = true
        local tw = Tween(frame, { Position = st.Rest }, 0.32, Enum.EasingStyle.Quint)
        st.Tween = tw
        tw.Completed:Connect(function() if st.Tween == tw then st.Tween = nil end end)
    else
        frame.Visible = false
    end
end

-- popups
-- Popups are CanvasGroups: they fade + scale in with a soft Quint ease and fade out instead of snapping.
local function ClosePopup(instant)
    local pp = Library.Popup
    if not pp then return end
    Library.Popup = nil
    Library.PopupClosed = { Frame = pp.Frame, T = os.clock() }
    local f = pp.Frame
    if pp.OnClose then pcall(pp.OnClose) end
    if instant == true or not f:IsA("CanvasGroup") then f.Visible = false return end
    local sc = f:FindFirstChildOfClass("UIScale")
    Tween(f, { GroupTransparency = 1 }, 0.14)
    if sc then Tween(sc, { Scale = 0.96 }, 0.14) end
    task.delay(0.15, function()
        if not (Library.Popup and Library.Popup.Frame == f) then f.Visible = false end
    end)
end

local function OpenPopup(frame, owner, onClose, ownerCloses)
    ClosePopup(true)
    local target = frame.Position
    frame.Position = target + UDim2.new(0, 0, 0, -8)
    if frame:IsA("CanvasGroup") then
        local sc = frame:FindFirstChildOfClass("UIScale") or New("UIScale", { Parent = frame })
        sc.Scale = 0.94
        frame.GroupTransparency = 1
        Tween(sc, { Scale = 1 }, 0.3, Enum.EasingStyle.Quint)
        Tween(frame, { GroupTransparency = 0 }, 0.2)
    end
    frame.Visible = true
    Tween(frame, { Position = target }, 0.3, Enum.EasingStyle.Quint)
    Library.Popup = { Frame = frame, Owner = owner, OnClose = onClose, OwnerCloses = ownerCloses, Opened = os.clock() }
end

Track(UIS.InputBegan:Connect(function(i)
    if Library.Popup and i.UserInputType == Enum.UserInputType.MouseButton1 then
        -- never close while a key is being rebound or something inside is being dragged
        if Library.ListeningKeybind or Library.ElementDragging or Library.WindowDragging then return end
        local p, pos = Library.Popup, Pt(i)
        local inOwner = p.Owner and Inside(p.Owner, pos)
        -- popups scale in over ~0.3s, so their on-screen rect is smaller at first: give them a margin (bigger while opening)
        local m = (p.Opened and os.clock() - p.Opened < 0.4) and 30 or 8
        local fp, fs = p.Frame.AbsolutePosition, p.Frame.AbsoluteSize
        local inFrame = pos.X >= fp.X - m and pos.X <= fp.X + fs.X + m and pos.Y >= fp.Y - m and pos.Y <= fp.Y + fs.Y + m
        if p.OwnerCloses and inOwner then
            ClosePopup()
        elseif not inFrame and not inOwner then
            ClosePopup()
        end
    end
end))

-- panel z-order (click to focus)
-- Panels always get EVEN z-indexes; their shadows use the odd number just below.
local function NormalizeZ()
    table.sort(Library.Panels, function(a, b) return a.ZIndex < b.ZIndex end)
    for i, p in ipairs(Library.Panels) do p.ZIndex = 8 + i * 2 end
    Library.TopZ = 8 + #Library.Panels * 2
end

local function BringToFront(frame)
    if frame.ZIndex >= Library.TopZ then return end
    Library.TopZ += 2
    frame.ZIndex = Library.TopZ
    if Library.TopZ > 88 then NormalizeZ() end
end

local function RegisterPanel(frame)
    Library.TopZ += 2
    frame.ZIndex = Library.TopZ
    table.insert(Library.Panels, frame)
end

Track(UIS.InputBegan:Connect(function(i)
    if i.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    local pos, best = Pt(i), nil
    for _, p in ipairs(Library.Panels) do
        if p.Parent and p.Visible and Inside(p, pos) and (not best or p.ZIndex > best.ZIndex) then best = p end
    end
    if best then BringToFront(best) end
end))

