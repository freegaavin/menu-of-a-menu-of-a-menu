        l:AddListBox({ Name = "Players", Height = 170, Callback = function(n) ping("Selected", tostring(n)) end }):SetValues(names)

        local r = tab:AddSection("right", "Info", "Display")
        r:AddUserCard({ Name = lp.Name, Badge = dopts.License or "Lifetime" })
        r:AddInfoRow({ Name = "Game ID", Value = tostring(game.GameId), Bright = true })
        r:AddInfoRow({ Name = "Place ID", Value = tostring(game.PlaceId) })
        r:AddInfoRow({ Name = "Job ID", Value = tostring(game.JobId ~= "" and game.JobId:sub(1, 13) .. "..." or "Studio") })
        r:AddDivider()
        r:AddLabel("Labels, dividers, info rows and user cards.")
    end
    do
        local tab = W:AddTab("Layout", "layout-grid", { Group = "SHOWCASE", Pages = { { Name = "Sections" }, { Name = "Pages", Icon = "layers" } } })
        local a = tab:AddSection("left", "Left Column", "Sections")
        a:AddLabel("Sections stack in two balanced columns.")
        a:AddToggle({ Name = "Example", Flag = "Showcase.Layout.A" })
        a:AddSlider({ Name = "Example Slider", Flag = "Showcase.Layout.B", Min = 0, Max = 10, Default = 5 })
        local c = tab:AddSection("right", "Right Column", "Sections")
        c:AddLabel("Click any section header to collapse it.")
        c:AddToggle({ Name = "Another Example", Flag = "Showcase.Layout.C" })
        local h = tab:AddSection("right", "Collapsed By Default", "Sections", { Collapsed = true })
        h:AddToggle({ Name = "Hidden Option A", Flag = "Showcase.Layout.HA" })
        h:AddToggle({ Name = "Hidden Option B", Flag = "Showcase.Layout.HB" })
        local p = tab:AddSection("left", "Pages", "Pages")
        p:AddLabel("A tab can hold several pages, switched from the top.")
        p:AddLabel("Use tab:AddSection(side, title, pageName).")
    end
    do
        local tab = W:AddTab("Widgets", "app-window", { Group = "SHOWCASE" })
        local n = tab:AddSection("left", "Notifications")
        n:AddButtonRow({
            { Name = "Info", Callback = function() Library:Notify("Info", "Something worth knowing", 3, "info") end },
            { Name = "Success", Callback = function() Library:Notify("Success", "That worked", 3, "check") end },
            { Name = "Warning", Callback = function() Library:Notify("Warning", "Careful with that", 3, "triangle-alert") end },
        })
        n:AddButton({ Name = "Long Message", Callback = function()
            Library:Notify("Notification", "Notifications stack, auto-dismiss and can hold longer text.", 5, "bell")
        end })
        local w = tab:AddSection("right", "Widgets")
        w:AddLabel("Toggle the watermark, keybind list, array list,")
        w:AddLabel("keystrokes, lag notifier and music overlay from")
        w:AddLabel("Options > Interface. Drag any of them to move it.")
        w:AddToggle({ Name = "Hotkey List Demo", Flag = "Showcase.HotkeyDemo", Display = "Hotkey List Demo" }):AddKeybind({ Default = "none", Mode = "Toggle" })
        w:AddLabel("Features with a keybind show up in the hotkey list.")
    end

    -- ESP preview (a live preview panel driven by its own toggles)
    do
        local tab = W:AddTab("Visuals", "eye", { Group = "COMMON", Pages = { { Name = "ESP", Icon = "scan-eye", Single = true } } })
        -- section titles + control names + colour flags match what the ESP preview reads (Prefix = "Visuals")
        local B1, B2 = Library.Brand.Color, Library.Brand.Color2
        local e = tab:AddSection("left", "ESP", "ESP")
        e:AddToggle({ Name = "Enabled", Display = "ESP", Default = true })
        e:AddToggle({ Name = "Outline", Default = true })
        local bx = tab:AddSection("left", "Box", "ESP")
        bx:AddToggle({ Name = "Enabled", Default = true }):AddColorPicker({ Flag = "BoxColor", Default = B1 })
        bx:AddToggle({ Name = "Fill Box" })
        local nm = tab:AddSection("left", "Name", "ESP")
        nm:AddToggle({ Name = "Enabled", Default = true }):AddColorPicker({ Flag = "NameColor", Default = Color3.new(1, 1, 1) })
        nm:AddDropdown({ Name = "Type", Values = { "Username", "Display" }, Default = "Username" })
        local hp = tab:AddSection("left", "Health", "ESP")
        hp:AddToggle({ Name = "Health Bar", Default = true }):AddColorPicker({ Flag = "HealthColor", Default = Color3.fromRGB(120, 225, 150) })
        hp:AddToggle({ Name = "Health Based", Default = true })
        hp:AddToggle({ Name = "Health Text" })
        local ind = tab:AddSection("left", "Indicators", "ESP")
        ind:AddToggle({ Name = "Distance", Default = true }):AddColorPicker({ Flag = "DistanceColor", Default = Color3.fromRGB(200, 204, 214) })
        ind:AddToggle({ Name = "Equipped Item" }):AddColorPicker({ Flag = "ItemColor", Default = Color3.fromRGB(200, 204, 214) })
        ind:AddToggle({ Name = "Skeleton" }):AddColorPicker({ Flag = "SkeletonColor", Default = Color3.new(1, 1, 1) })
        ind:AddToggle({ Name = "Head Dot" }):AddColorPicker({ Flag = "HeadDotColor", Default = B1 })
        ind:AddToggle({ Name = "Head Dot Glow" })
        local ch = tab:AddSection("left", "Chams", "ESP")
        ch:AddToggle({ Name = "Enabled", Display = "Chams" }):AddColorPicker({ Flag = "ChamsColor", Default = B1 })
        ch:AddToggle({ Name = "Filled", Default = true })
        local tr = tab:AddSection("left", "Tracer", "ESP")
        tr:AddToggle({ Name = "Enabled" }):AddColorPicker({ Flag = "TracerColor", Default = B2 })
        tr:AddDropdown({ Name = "Origin", Values = { "Top", "Center", "Bottom" }, Default = "Bottom" })
        pcall(function() Library:CreateESPPreview(tab, { Page = "ESP", Prefix = "Visuals" }) end)
    end

    -- OPTIONS (wired to the real library)
    do
        local tab = W:AddTab("Options", "settings", { Group = "COMMON", Pages = {
            { Name = "General", Icon = "sliders-horizontal" }, { Name = "Interface", Icon = "monitor" } } })

        -- General
        local g = tab:AddSection("left", "General", "General")
        g:AddKeybind({ Name = "Menu Key", Icon = "keyboard", Flag = "Options.MenuKey", Default = "ins", OnChange = function(k) Library:SetMenuKey(k) end })
        g:AddDropdown({ Name = "Theme", Values = Library.PresetNames, Default = "Luma", Callback = function(v) Library:ApplyTheme(v); if Library.SyncThemePickers then Library.SyncThemePickers() end end })
        g:AddColor({ Name = "Accent Color", Flag = "AccentColor", Default = Library.Brand.Color, NoAlpha = true, Callback = function(c) Library:SetAccent(c) end })
        g:AddSlider({ Name = "Menu Scale", Min = 0.6, Max = 1.4, Increment = 0.05, Default = 1, Callback = function(v) Library:SetScale(v) end })
        -- every colour in one place (changes apply live)
        local THEME_ROWS = {
            { "Accent", "Accent" }, { "Accent 2", "Accent2" }, { "Background", "Background" }, { "Cards", "Section" },
            { "Elements", "Element" }, { "Elements Off", "ElementOff" }, { "Slider Track", "Track" }, { "Popups", "Popup" },
            { "Widgets", "Widget" }, { "Widget Glass", "WidgetGlass" }, { "Dim Text", "TextDim" },
        }
        local tc = tab:AddSection("right", "Theme Colors", "General")
        local pickers, syncing = {}, false
        local function curColor(key)
            if key == "WidgetGlass" then return Library.GetWidgetGlass() end
            return Library.Theme[key]
        end
        for _, r in ipairs(THEME_ROWS) do
            pickers[r[2]] = tc:AddColor({ Name = r[1], Flag = "ThemeColors." .. r[2], Default = curColor(r[2]), NoAlpha = true,
                Callback = function(c) if not syncing then Library:SetThemeColor(r[2], c) end end })
        end
        tc:AddToggle({ Name = "Use Accent 2", Callback = function(v) Library:SetUseAccent2(v) end })
        local function syncPickers()
            syncing = true
            for key, p in pairs(pickers) do
                local o = Library.Options["ThemeColors." .. key]
                if o and o.Set then pcall(o.Set, o, curColor(key)) end
            end
            syncing = false
        end
        Library.SyncThemePickers = syncPickers
        tc:AddButton({ Name = "Reset Colors", Callback = function()
            Library:ApplyTheme(Library.CurrentPreset or "Dark")
            syncPickers()
        end })

        local cf = tab:AddSection("right", "Configs", "General")
        cf:AddButtonRow({
            { Name = "Open Folder", Callback = function() Library:OpenConfigFolder() end },
            { Name = "Refresh", Callback = function() Library:RefreshConfigs(); ping("Configs", "Refreshed") end },
        })
        cf:AddToggle({ Name = "Autoload This Config", Default = Library:GetAutoload() ~= nil, Callback = function(v)
            if v then
                if Library.CurrentConfig then Library:SetAutoload(Library.CurrentConfig)
                else Library:Notify("Configs", "Load or save a config first", 3) end
            else
                if Library:GetAutoload() then Library:SetAutoload(nil) end
            end
        end })
        cf:AddLabel("Use the config button at the top of the menu to save / load.")
        cf:AddDivider()
        cf:AddButton({ Name = "Unload", Callback = function() Library:Unload() end })

        -- Interface
        local ui = tab:AddSection("left", "User Interface", "Interface")
        ui:AddSlider({ Name = "Drag Transparency", Min = 0, Max = 0.95, Increment = 0.05, Default = 0.8, Callback = function(v) Library.DragFade = v end })
        ui:AddSlider({ Name = "Corner Roundness", Min = 0, Max = 1.6, Increment = 0.05, Default = 1, Callback = function(v) Library:SetRoundness(v) end })
        ui:AddToggle({ Name = "Dark Background", Callback = function(v) Library:SetDarkBackground(v) end })
        ui:AddToggle({ Name = "Window Blur", Default = true, Callback = function(v) Library:SetPanelBlur(v) end })
        ui:AddSlider({ Name = "Window Blur Amount", Min = 0, Max = 1, Increment = 0.05, Default = 0.85, Callback = function(v) Library:SetPanelBlurAmount(v) end })
        ui:AddToggle({ Name = "Screen Blur", Callback = function(v) Library:SetBlur(v) end })
        ui:AddSlider({ Name = "Blur Amount", Min = 0, Max = 56, Default = 20, Callback = function(v) Library:SetBlurSize(v) end })
        ui:AddSlider({ Name = "Transparency", Min = 0, Max = 0.9, Increment = 0.01, Default = 0.12, Callback = function(v) Library:SetGlassAlpha(v) end })
        ui:AddToggle({ Name = "Glass", Default = false, Callback = function(v)
            Library.GlassOff = not v
            if Library.ApplyGlass then pcall(Library.ApplyGlass, nil, true) end
        end })
        ui:AddTextbox({ Label = "Background Image ID", Placeholder = "asset id (leave empty to clear)", Flag = "Options.BgImage",
            Callback = function(t) Library:SetBackgroundImage(t) end })
        ui:AddSlider({ Name = "Image Opacity", Min = 0, Max = 1, Increment = 0.05, Default = 0.75, Callback = function(v) Library:SetBackgroundOpacity(v) end })
        ui:AddDropdown({ Name = "Image Fit", Values = { "Crop", "Fit", "Stretch", "Tile" }, Default = "Crop", Callback = function(v) Library:SetBackgroundFit(v) end })

        local el = tab:AddSection("right", "UI Elements", "Interface")
        local cfg = Library.ArrayCfg
        local function arr() if Library.RefreshArray then Library.RefreshArray(true) end end
        el:AddToggle({ Name = "Watermark", Default = true, Callback = function(v) Library:SetWidget("Watermark", v) end })
        el:AddToggle({ Name = "Keybind List", Default = true, Callback = function(v) Library:SetWidget("Hotkeys", v) end })
        el:AddToggle({ Name = "Music Overlay", Callback = function(v) Library:SetWidget("Music", v) end })
        el:AddToggle({ Name = "Keystroke", Callback = function(v) Library:SetWidget("Keystrokes", v) end })
        el:AddToggle({ Name = "Lag Notifier", Callback = function(v) Library:SetWidget("LagNotifier", v) end })
        el:AddToggle({ Name = "Array List", Default = true, Callback = function(v) Library:SetWidget("ArrayList", v) end })
        el:AddSlider({ Name = "Text Size", Min = 9, Max = 22, Default = cfg.TextSize, Callback = function(v) cfg.TextSize = v; arr() end })
        el:AddToggle({ Name = "Background", Default = cfg.Background, Callback = function(v) cfg.Background = v; arr() end })
        el:AddToggle({ Name = "Accent Line", Default = cfg.AccentLine, Callback = function(v) cfg.AccentLine = v; arr() end })
        el:AddToggle({ Name = "Gradient Text", Default = cfg.Gradient, Callback = function(v) cfg.Gradient = v; arr() end })
        el:AddSlider({ Name = "Gradient Speed", Min = 0, Max = 2, Increment = 0.05, Default = cfg.GradSpeed, Callback = function(v) cfg.GradSpeed = v end })
        el:AddDropdown({ Name = "Style", Values = { "Clean", "Bar", "Bracket", "Underline", "Glow" }, Default = cfg.Style, Callback = function(v) cfg.Style = v; arr() end })
    end

    -- widgets (all created once, visibility follows the toggles above)
    pcall(function() Library:CreateWatermark({ User = lp.Name }) end)
    pcall(function() Library:CreateHotkeyList() end)
    pcall(function() Library:CreateArrayList() end)
    pcall(function() Library:CreateKeystrokes(); Library:SetWidget("Keystrokes", false) end)
    pcall(function() Library:CreateLagNotifier(); Library:SetWidget("LagNotifier", false) end)
    pcall(function() Library:CreateMusicOverlay(); Library:SetWidget("Music", false) end)

    W:SetVisible(true)
    return W
end

-- auto-build the demo when nothing else made a window (set getgenv().LumaDemo = false to disable)
task.delay(1, function()
    if not Library.Dead and not Library.Window and genv.LumaDemo ~= false then
        local ok, err = pcall(function() Library:CreateDemo() end)
        if not ok then warn("[Luma] demo failed: " .. tostring(err)) end
    end
end)

genv.MatchaLibrary = Library

-- defaults: blue accent + a welcome toast (set getgenv().LumaQuiet = true to skip both)
if not genv.LumaQuiet then
    Library:SetAccent(Library.Brand.Color, nil)
    -- the toast only fires once a script actually builds a window (the library alone shows nothing)
    local baseCreate, toasted = Library.CreateWindow, false
    function Library:CreateWindow(opts)
        local W = baseCreate(self, opts)
        if not toasted then
            toasted = true
            task.delay(1.2, function() if not Library.Dead then Library:RunAutoload() end end) -- after the script finished adding controls
            task.delay(0.6, function()
                if not Library.Dead then Library:Notify("Loaded", "Press INSERT to toggle the menu", 4) end
            end)
        end
        return W
    end
end

return Library
