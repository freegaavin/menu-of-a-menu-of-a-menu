        cx = math.clamp(cx, 90, math.max(v.X - 90, 90))
        cy = math.clamp(cy - h / 2, 0, math.max(v.Y - 56, 0)) + h / 2
        return UDim2.new(pos.X.Scale, math.floor(cx - pos.X.Scale * v.X + 0.5), pos.Y.Scale, math.floor(cy - pos.Y.Scale * v.Y + 0.5))
