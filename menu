-- themes (presets)
-- Each preset tints the dark neutrals and sets the accent. Accent 2 is NOT touched by presets: it stays
-- white until the user (or a loaded config) changes it.
local PRESET_BASE = {
    Background = Color3.fromRGB(25, 26, 34), Section = Color3.fromRGB(36, 37, 47), Element = Color3.fromRGB(54, 56, 68),
    ElementOff = Color3.fromRGB(60, 62, 74), Track = Color3.fromRGB(44, 46, 58), Popup = Color3.fromRGB(28, 29, 38),
    Widget = Color3.fromRGB(17, 18, 24), TextDim = Color3.fromRGB(152, 154, 168),
}
local PRESET_NEAR = Color3.fromRGB(19, 19, 25)
Library.Presets = {
    { Name = "Dark",      Tint = Vector3.new(0, 0, 0),      Accent = Color3.fromRGB(255, 255, 255) },
    { Name = "Luma",      Tint = Vector3.new(-10, -8, 10),  Accent = Color3.fromRGB(150, 176, 236) },
    { Name = "Midnight",  Tint = Vector3.new(-12, -12, 8),  Accent = Color3.fromRGB(140, 160, 255) },
    { Name = "Ocean",     Tint = Vector3.new(-14, -3, 6),   Accent = Color3.fromRGB(90, 200, 230) },
    { Name = "Forest",    Tint = Vector3.new(-12, 3, -8),   Accent = Color3.fromRGB(120, 220, 140) },
    { Name = "Matcha",    Tint = Vector3.new(-10, 2, -14),  Accent = Color3.fromRGB(160, 210, 105) },
    { Name = "Rose",      Tint = Vector3.new(8, -12, -4),   Accent = Color3.fromRGB(255, 130, 170) },
    { Name = "Crimson",   Tint = Vector3.new(10, -14, -12), Accent = Color3.fromRGB(255, 90, 90) },
    { Name = "Amethyst",  Tint = Vector3.new(2, -12, 12),   Accent = Color3.fromRGB(190, 140, 255) },
    { Name = "Mocha",     Tint = Vector3.new(8, 2, -10),    Accent = Color3.fromRGB(230, 180, 130) },
    { Name = "Graphite",  Tint = Vector3.new(6, 6, 6),      Accent = Color3.fromRGB(205, 205, 210) },
}
Library.PresetNames = {}
for _, pr in ipairs(Library.Presets) do Library.PresetNames[#Library.PresetNames + 1] = pr.Name end
Library.CurrentPreset = "Dark"

local function Shift(c, v, k)
    local function ch(x, d) return math.clamp(math.floor(x * 255 + d * k + 0.5), 0, 255) end
    return Color3.fromRGB(ch(c.R, v.X), ch(c.G, v.Y), ch(c.B, v.Z))
end
local function Pack(c) return math.floor(c.R * 255 + 0.5) * 65536 + math.floor(c.G * 255 + 0.5) * 256 + math.floor(c.B * 255 + 0.5) end

local THEME_KEYS = { "Background", "Section", "Element", "ElementOff", "Track", "Popup", "Widget", "TextDim" }

function Library:ApplyTheme(name)
    local preset
    for _, pr in ipairs(Library.Presets) do if pr.Name == name then preset = pr break end end
    if not preset then return false end
    local T = Library.Theme

    -- map every old neutral colour to its new value, then recolour what is already on screen
    local map = {}
    local function add(old, new) local k = Pack(old); if not map[k] and Pack(old) ~= Pack(new) then map[k] = new end end
    for _, key in ipairs(THEME_KEYS) do
        local new = Shift(PRESET_BASE[key], preset.Tint, key == "TextDim" and 0.5 or 1)
        add(T[key], new)
        T[key] = new
    end
    local newNear = Shift(PRESET_NEAR, preset.Tint, 1)
    add(GLASS.Near, newNear)
    GLASS.Near = newNear

    local function fix(inst, prop)
        local n = map[Pack(inst[prop])]
        if n then inst[prop] = n end
    end
    for _, d in ipairs(Library.Gui:GetDescendants()) do
        if d:IsA("GuiObject") then
            fix(d, "BackgroundColor3")
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then fix(d, "TextColor3") end
            if d:IsA("TextBox") then fix(d, "PlaceholderColor3") end
            if d:IsA("ImageLabel") or d:IsA("ImageButton") then fix(d, "ImageColor3") end
        elseif d:IsA("UIStroke") then
            fix(d, "Color")
        end
    end

    Library.CurrentPreset = preset.Name
    Library:SetAccent(preset.Accent, nil)
    local ao = Library.Options["AccentColor"]
    if ao then ao:Set(preset.Accent) end
    return true
end

-- Library:SetThemeColor("Background"|"Section"|"Element"|"ElementOff"|"Track"|"Popup"|"Widget"|"TextDim"|"WidgetGlass"|"Accent"|"Accent2", Color3)
-- recolours everything already on screen (same technique as ApplyTheme) and every control created afterwards.
function Library.GetWidgetGlass() return GLASS.Near end

function Library:SetThemeColor(key, c)
    if typeof(c) ~= "Color3" then return false end
    if key == "Accent" then Library:SetAccent(c, nil) return true end
    if key == "Accent2" then Library:SetAccent(nil, c) return true end
    local T = Library.Theme
    local old
    if key == "WidgetGlass" then old = GLASS.Near else old = T[key] end
    if not old or Pack(old) == Pack(c) then return old ~= nil end
    if key == "WidgetGlass" then GLASS.Near = c else T[key] = c end
    local from, to = Pack(old), c
    local function fix(inst, prop)
        if Pack(inst[prop]) == from then inst[prop] = to end
    end
    for _, d in ipairs(Library.Gui:GetDescendants()) do
        if d:IsA("GuiObject") then
            fix(d, "BackgroundColor3")
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then fix(d, "TextColor3") end
            if d:IsA("TextBox") then fix(d, "PlaceholderColor3") end
            if d:IsA("ImageLabel") or d:IsA("ImageButton") then fix(d, "ImageColor3") end
        elseif d:IsA("UIStroke") then
            fix(d, "Color")
        end
    end
    if Library.SideFill and Library.SideFill.Parent then Library.SideFill.BackgroundColor3 = Library.SideColor() end
    return true
end

-- configs (save / load flags to JSON)
local FS = {
    write = writefile, read = readfile, isfile = isfile, isfolder = isfolder,
    mkfolder = makefolder, list = listfiles, del = delfile,
}
Library.ConfigRoot = tostring(genv.MatchaFolder or "Matcha")
Library.ConfigDir = Library.ConfigRoot .. "/configs"
Library.MemConfigs = {} -- fallback when the executor has no file functions
Library.NoSave = { ConfigName = true }

local function CanFS() return FS.write ~= nil and FS.read ~= nil and FS.list ~= nil and FS.isfolder ~= nil and FS.mkfolder ~= nil end
local function EnsureDir()
    if not CanFS() then return false end
    pcall(function() if not FS.isfolder(Library.ConfigRoot) then FS.mkfolder(Library.ConfigRoot) end end)
    pcall(function() if not FS.isfolder(Library.ConfigDir) then FS.mkfolder(Library.ConfigDir) end end)
    return true
end
local function CleanName(n)
    n = tostring(n or ""):gsub("[^%w _%-%.]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    return n:sub(1, 40)
end
local function EncodeValue(v)
    local t = typeof(v)
    if t == "Color3" then return { t = "c", r = v.R, g = v.G, b = v.B } end
    if t == "boolean" or t == "number" or t == "string" then return v end
    return nil
end

function Library:ListConfigs()
    local out = {}
    if CanFS() and EnsureDir() then
        local ok, files = pcall(FS.list, Library.ConfigDir)
        if ok and type(files) == "table" then
            for _, f in ipairs(files) do
                local n = tostring(f):match("([^/\\]+)%.json$")
                if n then out[#out + 1] = n end
            end
        end
    else
        for n in pairs(Library.MemConfigs) do out[#out + 1] = n end
    end
    table.sort(out, function(a, b) return a:lower() < b:lower() end)
    return out
end

function Library:RefreshConfigs()
    if Library.ConfigListBox then Library.ConfigListBox:SetValues(Library:ListConfigs()) end
    if Library.RefreshPresets then Library.RefreshPresets() end
end

function Library:SaveConfig(name)
    name = CleanName(name)
    if name == "" then Library:Notify("Configs", "Type a config name first", 3) return false end
    local flags, count = {}, 0
    for flag in pairs(Library.Options) do
        if not Library.NoSave[flag] then
            local ev = EncodeValue(Library.Flags[flag])
            if ev ~= nil then
                local o = Library.Options[flag]
                if type(ev) == "table" and o and o.Alpha then ev.a = o.Alpha end -- colour transparency
                flags[flag] = ev; count += 1
            end
        end
    end
    local ok, json = pcall(function() return HttpService:JSONEncode({ version = 1, name = name, flags = flags }) end)
    if not ok then Library:Notify("Configs", "Could not encode config", 3) return false end
    if CanFS() and EnsureDir() then
        local wok = pcall(FS.write, Library.ConfigDir .. "/" .. name .. ".json", json)
        if not wok then Library:Notify("Configs", "Could not write the file", 3) return false end
    else
        Library.MemConfigs[name] = json
    end
    Library:RefreshConfigs()
    if Library.ConfigListBox then Library.ConfigListBox:Select(name, false) end
    Library.CurrentConfig = name
    if Library.RefreshConfigBar then Library.RefreshConfigBar() end
    if Library.RefreshPresets then Library.RefreshPresets() end
    Library:Notify("Configs", ("Saved '%s' (%d options)"):format(name, count), 3)
    return true
end

-- config autoload: the chosen config name is stored in <ConfigRoot>/autoload.txt and loaded a moment after the window is built
Library.MemAutoload = nil
function Library:GetAutoload()
    if CanFS() then
        local path = Library.ConfigRoot .. "/autoload.txt"
        local ok, v = pcall(function() return FS.isfile(path) and FS.read(path) or nil end)
        if ok and v then
            v = tostring(v):gsub("%s+", "")
            return v ~= "" and v or nil
        end
        return nil
    end
    return Library.MemAutoload
end

function Library:SetAutoload(name)
    name = name and CleanName(name) or nil
    if name == "" then name = nil end
    if CanFS() and EnsureDir() then
        pcall(FS.write, Library.ConfigRoot .. "/autoload.txt", name or "")
    end
    Library.MemAutoload = name
    if Library.RefreshPresets then Library.RefreshPresets() end
    Library:Notify("Configs", name and ("'" .. name .. "' will load automatically") or "Autoload turned off", 3)
    return true
end

function Library:RunAutoload()
    if Library.AutoloadDone then return false end
    Library.AutoloadDone = true
    local name = Library:GetAutoload()
    if not name then return false end
    for _, n in ipairs(Library:ListConfigs()) do
        if n == name then return Library:LoadConfig(name) end
    end
    return false
end

function Library:LoadConfig(name)
    name = CleanName(name)
    if name == "" then Library:Notify("Configs", "Pick a config first", 3) return false end
    local json
    if CanFS() and EnsureDir() then
        local path = Library.ConfigDir .. "/" .. name .. ".json"
        local ok, data = pcall(function() return FS.isfile(path) and FS.read(path) or nil end)
        json = ok and data or nil
    else
        json = Library.MemConfigs[name]
    end
    if not json then Library:Notify("Configs", "Config '" .. name .. "' not found", 3) return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(data) ~= "table" or type(data.flags) ~= "table" then
        Library:Notify("Configs", "That config file is corrupted", 3)
        return false
    end
    -- theme preset first so the saved accent colours land on top of it
    local keys = {}
    for k in pairs(data.flags) do keys[#keys + 1] = k end
    table.sort(keys, function(a, b)
        if a == "ThemePreset" then return b ~= "ThemePreset" end
        if b == "ThemePreset" then return false end
        return a < b
    end)
    local applied = 0
    for _, k in ipairs(keys) do
        local opt, v = Library.Options[k], data.flags[k]
        if opt and not Library.NoSave[k] then
            local good = pcall(function()
                if type(v) == "table" and v.t == "c" then
                    opt:Set(Color3.new(v.r, v.g, v.b), true, v.a)
                else
                    opt:Set(v)
                end
            end)
            if good then applied += 1 end
        end
    end
    if Library.ConfigListBox then Library.ConfigListBox:Select(name, false) end
    Library.CurrentConfig = name
    if Library.RefreshConfigBar then Library.RefreshConfigBar() end
    if Library.RefreshPresets then Library.RefreshPresets() end
    Library:Notify("Configs", ("Loaded '%s' (%d options)"):format(name, applied), 3)
    return true
end

function Library:DeleteConfig(name)
    name = CleanName(name)
    if name == "" then
        Library:Notify("Configs", "Pick a config first", 3)
        return false
    end
    if CanFS() and EnsureDir() then
        if not FS.del then
            Library:Notify("Configs", "File deletion is unavailable", 4)
            return false
        end
        local path = Library.ConfigDir .. "/" .. name .. ".json"
        local existsOk, exists = pcall(FS.isfile, path)
        if existsOk and not exists then
            Library:Notify("Configs", "Config '" .. name .. "' not found", 3)
            return false
        end
        local ok, err = pcall(FS.del, path)
        if not ok then
            Library:Notify("Configs", "Could not delete the file: " .. tostring(err):sub(1, 100), 4)
            return false
        end
    elseif not Library.MemConfigs[name] then
        Library:Notify("Configs", "Config '" .. name .. "' not found", 3)
        return false
    end
    Library.MemConfigs[name] = nil
    if Library.CurrentConfig == name then
        Library.CurrentConfig = nil
        if Library.RefreshConfigBar then Library.RefreshConfigBar() end
    end
    Library:RefreshConfigs()
    Library:Notify("Configs", "Deleted '" .. name .. "'", 3)
    return true
end

-- Opens the configs folder in the file explorer. Roblox executors don't share one API for that, so this tries every
-- opener we know about; if none exists it copies the path to your clipboard instead. If you know your workspace path,
-- set getgenv().MatchaWorkspacePath = "C:\\path\\to\\workspace" BEFORE loading to make the explorer fallback work.
function Library:OpenConfigFolder()
    EnsureDir()
    local rel = Library.ConfigDir
    local function fn(name)
        local f = (getgenv and getgenv()[name]) or rawget(_G, name)
        return type(f) == "function" and f or nil
    end
    local opened = false
    for _, name in ipairs({ "openfolder", "open_folder", "showfolder", "revealfolder", "openinexplorer", "openexplorer" }) do
        local f = fn(name)
        if f and pcall(f, rel) then opened = true break end
    end
    local abs = genv.MatchaWorkspacePath and (tostring(genv.MatchaWorkspacePath):gsub("[/\\]+$", "") .. "\\" .. rel:gsub("/", "\\")) or nil
    if not opened and abs then
        for _, name in ipairs({ "shellexecute", "ShellExecute", "runcmd" }) do
            local f = fn(name)
            if f and pcall(f, "explorer.exe", '"' .. abs .. '"') then opened = true break end
        end
        if not opened and type(os.execute) == "function" then
            opened = pcall(os.execute, 'start "" explorer "' .. abs .. '"')
        end
    end
    if opened then
        Library:Notify("Configs", "Opened the configs folder", 3)
        return true
    end
    local shown = abs or ("workspace/" .. rel)
    local copy = fn("setclipboard") or fn("toclipboard") or fn("set_clipboard")
    if copy and pcall(copy, shown) then
        Library:Notify("Configs", "Your executor can't open folders - path copied: " .. shown, 5)
    else
        Library:Notify("Configs", "Your executor can't open folders. Configs are in: " .. shown, 5)
    end
    return false
end

function Library:Unload()
    Library.Dead = true
    for _, c in ipairs(Library.Conns) do pcall(function() c:Disconnect() end) end
    Library.Conns = {}
    pcall(function() Blur:Destroy() end)
    pcall(function() if PB.Dof then PB.Dof:Destroy() end end)
    pcall(function() if PB.Part then PB.Part:Destroy() end end)
    pcall(function() Gui:Destroy() end)
    if genv.MatchaLibrary == Library then genv.MatchaLibrary = nil end
end

