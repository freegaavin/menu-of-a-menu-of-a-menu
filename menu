        end

        function E:AddButtonRow(list)
            local row = Row(RH)
            local n = #list
            local holder = New("Frame", {
                BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
                Size = UDim2.new(1, 0, 0, 28), Parent = row,
            })
            List(holder, 6, H)
            for _, o in ipairs(list) do
                MakeButton(holder, o.Name, UDim2.new(1 / n, -(6 * (n - 1)) / n, 0, 28), o.Callback)
            end
            return row
        end

        function E:AddLabel(text, color)
            local row = Row(30)
            return Text(row, text, { Color = color or T.TextDim })
        end

        function E:AddColor(opts)
            opts = opts or {}
            local row = Row(RH)
            rowLabel(row, opts, 50)
            return AttachColorPicker(newHolder(row, 0), flagOf(opts), opts.Default, opts.Callback, opts.NoAlpha)
        end

        function E:AddKeybind(opts)
            opts = opts or {}
            local row = Row(RH)
            rowLabel(row, opts, 110)
            return AttachKeybind(newHolder(row, 0), flagOf(opts), opts.Default or "none", opts.Callback, nil, opts.OnChange)
        end

        function E:AddNav(opts)
            opts = opts or {}
            local row = Row(RH)
            local lbl = rowLabel(row, opts, 30)
            local ch = Icon(row, "chevron-right", 14, T.TextDim)
            ch.AnchorPoint = Vector2.new(1, 0.5)
            ch.Position = UDim2.new(1, 0, 0.5, 0)
            local hit = New("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = row })
            hit.MouseEnter:Connect(function() Tween(lbl, { TextColor3 = T.Text }, 0.1) end)
            hit.MouseLeave:Connect(function() Tween(lbl, { TextColor3 = opts.Color or LBL }, 0.1) end)
            hit.MouseButton1Click:Connect(function() if opts.Callback then task.spawn(opts.Callback) end end)
            return row
        end

        function E:AddDivider()
            local r = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 9), Parent = container })
            New("Frame", {
                BackgroundColor3 = T.Stroke, BackgroundTransparency = 0.9, BorderSizePixel = 0,
                AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 1), Parent = r,
            })
        end
    end

    return E
end

-- MODERN WINDOW (sidebar layout)
-- window / sidebar / card transparency, all derived from Library.GlassAlpha (Library:SetGlassAlpha changes it live)
function Library.GlassValues()
    if Library.GlassOff then return 0, 0.3, 0.24 end
    local a = Library.GlassAlpha
    return a, math.clamp(a + 0.28, 0, 0.95), math.clamp(a + 0.12, 0, 0.95)
end

-- Same API as the classic window, different skin. Switch with the Style dropdown (Options > User Interface)
-- or getgenv().MatchaStyle = "Modern" before executing.
-- Sections are collapsible: click the header (or pass { Collapsed = true } as the 4th argument of tab:AddSection).
local function MakeModernSection(tab, title, prefix, pageName, sopts)
    local T = Library.Theme
    local S = {}
    sopts = sopts or {}
    -- A group = dim uppercase header + rounded card + small gap. Nothing is parented until its first row exists;
    -- then it drops into the lighter column of its page (balanced columns, or one column for "Single" pages).
    local function group(label, pgName, gopts)
        gopts = gopts or {}
        local pg = tab:GetPage(pgName or pageName)
        local DIM = Color3.fromRGB(122, 124, 140)
        local head = New("TextLabel", {
            BackgroundTransparency = 1, Text = string.upper(label), TextColor3 = DIM, TextSize = 11,
            FontFace = F_SEMI, TextXAlignment = TLEFT, Size = UDim2.new(1, 0, 0, 30),
        })
        Pad(head, 3, 0, 0, 0)
        local card = New("Frame", {
            BackgroundColor3 = T.Background, BackgroundTransparency = select(3, Library.GlassValues()), Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y, ClipsDescendants = true,
        })
        Corner(card, 10); Pad(card, 11, 0, 11, 0)
        -- "lit from above" border: brighter at the top edge, fading out towards the bottom
        local cardStroke = Stroke(card, 0)
        New("UIGradient", {
            Rotation = 90, Parent = cardStroke,
            Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0.88) }),
        })
        local layout = List(card, 0)
        Library.Cards[#Library.Cards + 1] = card
        local gap = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 7) })

        -- collapse / expand
        local key = tostring(tab.Name) .. ":" .. tostring(label)
        local collapsed = Library.Collapsed[key]
        if collapsed == nil then collapsed = gopts.Collapsed == true end
        local lastH, anim = 0, 0
        local chev = Chevron(head, UDim2.new(1, -10, 0.5, 0), DIM)
        chev.Rotation = collapsed and -90 or 0
        local hit = New("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = head })
        hit.MouseEnter:Connect(function()
            Tween(head, { TextColor3 = T.Text }, 0.12)
            for _, l in ipairs(chev:GetChildren()) do Tween(l, { BackgroundColor3 = T.Text }, 0.12) end
        end)
        hit.MouseLeave:Connect(function()
            Tween(head, { TextColor3 = DIM }, 0.12)
            for _, l in ipairs(chev:GetChildren()) do Tween(l, { BackgroundColor3 = DIM }, 0.12) end
        end)
        layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            if card.Visible and anim == 0 then lastH = layout.AbsoluteContentSize.Y / Library.Scale end
        end)
        if collapsed then card.Visible = false end

        local function setCollapsed(c, instant)
            c = c and true or false
            if c == collapsed and not instant then return end
            collapsed = c
            Library.Collapsed[key] = c
            anim += 1
            local my = anim
            if instant or not card.Parent then
                card.Visible = not c
                chev.Rotation = c and -90 or 0
                if not c then card.AutomaticSize = Enum.AutomaticSize.Y; card.Size = UDim2.new(1, 0, 0, 0) end
                return
            end
            Tween(chev, { Rotation = c and -90 or 0 }, 0.22, Enum.EasingStyle.Quint)
            if c then
                local h = math.max(card.AbsoluteSize.Y / Library.Scale, 1)
                lastH = h
                card.AutomaticSize = Enum.AutomaticSize.None
                card.Size = UDim2.new(1, 0, 0, h)
                Tween(card, { Size = UDim2.new(1, 0, 0, 0) }, 0.24, Enum.EasingStyle.Quint)
                task.delay(0.25, function()
                    if anim == my and collapsed then card.Visible = false end
                end)
            else
                if lastH <= 0 then -- never measured: just show it
                    card.AutomaticSize = Enum.AutomaticSize.Y
                    card.Visible = true
                    return
                end
                card.AutomaticSize = Enum.AutomaticSize.None
                card.Size = UDim2.new(1, 0, 0, 0)
                card.Visible = true
                Tween(card, { Size = UDim2.new(1, 0, 0, lastH) }, 0.28, Enum.EasingStyle.Quint)
                task.delay(0.3, function()
                    if anim == my and not collapsed then
                        card.AutomaticSize = Enum.AutomaticSize.Y
                        card.Size = UDim2.new(1, 0, 0, 0)
                    end
                end)
            end
        end
        hit.MouseButton1Click:Connect(function() setCollapsed(not collapsed) end)

        local placed, colIdx = false, 1
        local skin = {
            RowH = 36,
            Reveal = function()
                if placed then return end
                placed = true
                local col
                col, colIdx = pg.Pick()
                head.Parent, card.Parent, gap.Parent = col, col, col
                local n = #pg.Groups + 1
                head.LayoutOrder, card.LayoutOrder, gap.LayoutOrder = n * 3, n * 3 + 1, n * 3 + 2
                pg.Groups[n] = { Head = head, Card = card, Gap = gap, IsCollapsed = function() return collapsed end, SetCollapsed = setCollapsed }
                pg.W[colIdx] += 32
            end,
            OnRow = function(h) if placed then pg.W[colIdx] += h end end,
        }
        return skin, card, setCollapsed
    end

    if title then
        local skin, card, setC = group(title, nil, sopts)
        for k, v in pairs(BuildElements(card, prefix .. "." .. title, skin)) do S[k] = v end
        S.SetCollapsed = function(_, c) setC(c) end
    end

    -- classic sub-tabs become stacked groups; pageMap = { SubTabName = "Page" } can send some to other pages
    function S:AddSubTabs(names, pageMap)
        local tabs = {}
        for _, n in ipairs(names) do
            local skin, card = group(n, pageMap and pageMap[n])
            tabs[n] = BuildElements(card, prefix .. "." .. n, skin)
        end
        return tabs
    end
    return S
end

function Library:CreateModernWindow(opts)
    opts = opts or {}
    local T = Library.Theme
    local W = { Tabs = {}, Current = nil, Style = "Modern" }
    local vp = Viewport()
    local SIDE = 176 -- wider sidebar = broader script title header (was 160)
    local HEAD = 56
    local MIN_W, MIN_H = 600, 420
    local width = math.min((opts.Size and opts.Size.X) or 800, vp.X - 20)
    local height = math.min((opts.Size and opts.Size.Y) or 580, vp.Y - 40)
    local userName = opts.User or LocalPlayer.Name
    local LBL = Color3.fromRGB(212, 212, 218)

    local main = New("Frame", {
        Name = "Window", BackgroundColor3 = T.Widget, BackgroundTransparency = (Library.GlassValues()),
        Size = UDim2.new(0, width, 0, height), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 20), Visible = false, Parent = Root,
    })
    Corner(main, 18)
    RegisterPanel(main)
    ShadowFill(main, 18, { Spread = 14, Offset = 3, Strength = 0.135 })
    local mainStroke = Stroke(main, 0)
    mainStroke.Thickness = 0
    mainStroke.Enabled = false
    New("UIGradient", {
        Rotation = 90, Parent = mainStroke,
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.72), NumberSequenceKeypoint.new(1, 0.88) }),
    })
    W.Main = main
    -- faint frosted haze behind everything in the window: soft light at the top fading down, so the glass reads as frosted
    local haze = New("Frame", {
        Name = "Haze", BackgroundColor3 = WHITE, BackgroundTransparency = 0.955, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0), ZIndex = 0, Parent = main,
    })
    Corner(haze, 18)
    New("UIGradient", {
        Rotation = 90, Parent = haze,
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
    })

    -- custom background image (Library:SetBackgroundImage). Sits above the haze and below everything else, so the
    -- sidebar tint and the translucent cards show it through.
    local bgImg = New("ImageLabel", {
        Name = "BgImage", BackgroundTransparency = 1, Image = "", ImageTransparency = 1,
        ScaleType = Enum.ScaleType.Crop, Size = UDim2.new(1, 0, 1, 0), ZIndex = 0, Visible = false, Parent = main,
    })
    Corner(bgImg, 18)
    W.BgImage = bgImg

    -- sidebar
    -- sidebar tint: a CanvasGroup rounds only the LEFT corners (the fill is narrower than the group), so no
    -- translucent layers ever overlap by accident
    local sideBg = New("CanvasGroup", { BackgroundTransparency = 1, Size = UDim2.new(0, SIDE + 40, 1, 0), Parent = main })
    Corner(sideBg, 18)
    local sideFill = New("Frame", {
        BackgroundColor3 = Library.SideColor(), BackgroundTransparency = select(2, Library.GlassValues()), BorderSizePixel = 0,
        Size = UDim2.new(0, SIDE, 1, 0), Parent = sideBg,
    })
    Library.SideFill = sideFill
    local side = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, SIDE, 1, 0), Parent = main })
    -- hairline divider that fades out at both ends, so the sidebar reads as its own panel
    local sideEdge = New("Frame", {
        BackgroundColor3 = WHITE, BorderSizePixel = 0, Position = UDim2.new(0, SIDE - 1, 0, 0), Size = UDim2.new(0, 1, 1, 0), Parent = main,
    })
    New("UIGradient", {
        Rotation = 90, Parent = sideEdge,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.12, 0.86),
            NumberSequenceKeypoint.new(0.88, 0.86), NumberSequenceKeypoint.new(1, 1),
        }),
    })

    -- "Glass" option: translucent vs solid
    local function applyGlass(on, instant)
        if on ~= nil then Library.GlassOff = not on end
        local m, sd, cd = Library.GlassValues()
        local t = instant and 0 or 0.2
