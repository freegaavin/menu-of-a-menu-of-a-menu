local Anim = {}
local AccentGradients = {}
local AnimTime = 0

function Library.GetAccent2()
    return Library.UseAccent2 and Library.Theme.Accent2 or Library.Theme.Accent
end
local function AccentSeq(solid)
    local T = Library.Theme
    local c2 = (solid or not Library.UseAccent2) and T.Accent or T.Accent2
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, T.Accent),
        ColorSequenceKeypoint.new(0.5, c2),
        ColorSequenceKeypoint.new(1, T.Accent),
    })
end

-- kind "slide": offset sweeps -1..1 ; kind "rotate": rotation spins
local function Animate(g, speed, phase, kind)
    Anim[#Anim + 1] = { G = g, Speed = speed or 0.4, Phase = phase or 0, Kind = kind or "slide" }
end

-- solid = true: always the primary accent only (used on the sidebar, sliders, toggles)
local function AccentGradient(parent, speed, phase, rotation, solid)
    local g = New("UIGradient", { Color = AccentSeq(solid), Rotation = rotation or 0, Parent = parent })
    if solid then g:SetAttribute("Solid", true) end
    Animate(g, speed or 0.4, phase or 0)
    AccentGradients[#AccentGradients + 1] = g
    return g
end

-- things that should always wear the accent colour (widget icons, pressed keys...): Library.Tint(instance, "ImageColor3")
local AccentTints = {}
function Library.Tint(inst, prop, darken)
    AccentTints[#AccentTints + 1] = { I = inst, P = prop, D = darken }
    inst[prop] = darken and Library.Theme.Accent:Lerp(Color3.new(0, 0, 0), darken) or Library.Theme.Accent
    return inst
end

function Library:SetAccent(c1, c2)
    Library.Theme.Accent = c1 or Library.Theme.Accent
    Library.Theme.Accent2 = c2 or Library.Theme.Accent2
    for i = #AccentTints, 1, -1 do
        local t = AccentTints[i]
        if t.I.Parent then
            local c = t.D and Library.Theme.Accent:Lerp(Color3.new(0, 0, 0), t.D) or Library.Theme.Accent
            Tween(t.I, { [t.P] = c }, 0.2)
        else
            table.remove(AccentTints, i)
        end
    end
