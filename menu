function Library:CreateWatermark(opts)
    opts = opts or {}
    local user = opts.User or LocalPlayer.Name
    local TS = 15 -- text size (bigger watermark)
    ICON_ALIASES.external = { "square-arrow-out-up-right", "external-link", "map-pin" }
    ICON_ALIASES.fpsicon = { "chart-no-axes-column", "bar-chart-3", "bar-chart", "monitor" }

    local wm, wmStroke = Glass(Root, 8, 0.2, 0.6) -- hairline border: animated blue gradient (see below)
    Shadow(wm, 8, { Spread = 9, Offset = 2, Strength = 0.28 })
    wm.AnchorPoint = Vector2.new(0.5, 0)
    wm.Position = UDim2.new(0.5, 0, 0, 72)
