    -- list box (selectable rows, like the real Config List)
    -- opts: Name (label above), Height, Callback(name) on selection.  obj:SetValues(list), obj:Select(name), obj.Value
    function E:AddListBox(opts)
        opts = opts or {}
        local height = opts.Height or 150
        local labelH = opts.Name and 22 or 0
        local row = Row(labelH + height + 6)
        if opts.Name then Text(row, opts.Name, { SizeUDim = UDim2.new(1, 0, 0, 18), Color = T.TextDim }) end
        local box = New("Frame", {
            BackgroundColor3 = T.Element, BackgroundTransparency = 0.6,
            Position = UDim2.new(0, 0, 0, labelH), Size = UDim2.new(1, 0, 0, height), Parent = row,
        })
        Corner(box, 10); Stroke(box, 0.9)
        local scroll = New("ScrollingFrame", {
            BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, ScrollBarImageColor3 = T.TextDim,
            ScrollingDirection = Enum.ScrollingDirection.Y, Parent = box,
        })
        Pad(scroll, 8, 8, 8, 8); List(scroll, 2)

        local obj = { Value = nil }
        local items = {}
        local function paint(name, on)
            local it = items[name]
            if not it then return end
            it.Bar.Visible = on
            it.Btn.FontFace = on and F_SEMI or F_MED
            Tween(it.Btn, { BackgroundTransparency = on and 0.55 or 1, TextColor3 = on and T.Text or T.TextDim }, 0.12)
        end
        function obj:Select(name, fire)
            if obj.Value and obj.Value ~= name then paint(obj.Value, false) end
            obj.Value = name
            if name then paint(name, true) end
            if fire ~= false and name and opts.Callback then task.spawn(opts.Callback, name) end
        end
        function obj:SetValues(list)
            for _, it in pairs(items) do it.Btn:Destroy() end
            items = {}
            for i, name in ipairs(list or {}) do
                local b = New("TextButton", {
                    Text = name, AutoButtonColor = false, BackgroundColor3 = T.Element, BackgroundTransparency = 1,
                    TextColor3 = T.TextDim, TextSize = 12, FontFace = F_MED, TextXAlignment = TLEFT,
                    LayoutOrder = i, Size = UDim2.new(1, 0, 0, 28), Parent = scroll,
                })
                Corner(b, 6); Pad(b, 14, 0, 0, 0)
                local bar = New("Frame", {
                    BackgroundColor3 = WHITE, BorderSizePixel = 0, Visible = false,
                    AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -10, 0.5, 0), Size = UDim2.new(0, 3, 0, 18), Parent = b,
                })
                Corner(bar, 2)
                items[name] = { Btn = b, Bar = bar }
                b.MouseEnter:Connect(function() if obj.Value ~= name then Tween(b, { BackgroundTransparency = 0.8 }, 0.1) end end)
                b.MouseLeave:Connect(function() if obj.Value ~= name then Tween(b, { BackgroundTransparency = 1 }, 0.1) end end)
                b.MouseButton1Click:Connect(function() obj:Select(name) end)
            end
            if obj.Value and items[obj.Value] then paint(obj.Value, true) else obj.Value = nil end
        end
        function obj:Get() return obj.Value end
        return obj
    end

    -- MODERN SKIN
    do
        local RH = skin.RowH or 36
        local LBL = Color3.fromRGB(212, 212, 218)

        local function rowLabel(row, opts, rightPad)
            local x = 0
            if opts.Icon then
                local ic = Icon(row, opts.Icon, 15, T.TextDim)
                ic.AnchorPoint = Vector2.new(0, 0.5)
                ic.Position = UDim2.new(0, 0, 0.5, 0)
                x = 26
            end
            local lbl = Text(row, opts.Name or "", {
                Position = UDim2.new(0, x, 0, 0), SizeUDim = UDim2.new(1, -(x + rightPad), 1, 0),
                Color = opts.Color or LBL, Truncate = Enum.TextTruncate.AtEnd,
            })
            return lbl, x
        end

        -- right-aligned strip for swatches / dots; xOff leaves room for a switch
        local function newHolder(row, xOff)
            local h = New("Frame", {
                BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, xOff or 0, 0.5, 0),
                Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X, Parent = row,
            })
            List(h, 8, H, RIGHT, VCENTER)
            return h
        end

        -- the pill switch
        local function Switch(parent)
            local sw = New("TextButton", {
                Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(58, 58, 66),
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 34, 0, 18), Parent = parent,
            })
            Corner(sw, 9)
            local sheen = New("UIGradient", { Color = AccentSeq(true), Parent = sw }) -- static accent tint (no animation)
            sheen:SetAttribute("Solid", true)
            AccentGradients[#AccentGradients + 1] = sheen
            sheen.Enabled = false
            local knob = New("Frame", {
                BackgroundColor3 = Color3.fromRGB(138, 138, 148), AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.new(0, 12, 0, 12), ZIndex = 2, Parent = sw,
            })
            Corner(knob, 6)
            local function paint(on, animate)
                sheen.Enabled = on
                local dur = animate and 0.18 or 0
                Tween(sw, { BackgroundColor3 = on and WHITE or Color3.fromRGB(58, 58, 66) }, dur)
                Tween(knob, {
                    Position = on and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                    BackgroundColor3 = on and Color3.fromRGB(30, 31, 40) or Color3.fromRGB(138, 138, 148), -- dark knob on the bright track = crisper contrast
                }, dur, Enum.EasingStyle.Quint)
            end
            return sw, paint
        end

        -- toggle
        function E:AddToggle(opts)
            opts = opts or {}
            local flag = flagOf(opts)
            local row = Row(RH)
            local lbl, lx = rowLabel(row, opts, 56)
            local sw, paint = Switch(row)
            local hit = New("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, -60, 1, 0), Parent = row })
            local obj = { Value = false, Flag = flag }
            local holder
            local function widen() lbl.Size = UDim2.new(1, -(lx + 130), 1, 0) end

            local function set(v, fire)
                obj.Value = v
                Library.Flags[flag] = v
                paint(v, fire ~= false)
                if fire ~= false then
                    if v then Shine(sw, 9, 0.55) end
                    if opts.Callback then task.spawn(opts.Callback, v) end
                end
                if Library.RefreshHotkeys then Library.RefreshHotkeys() end
                if Library.RefreshArray then Library.RefreshArray() end
            end
            sw.MouseButton1Click:Connect(function() set(not obj.Value) end)
            hit.MouseButton1Click:Connect(function() set(not obj.Value) end)

            function obj:Set(v) set(v) end
            function obj:Get() return obj.Value end

            -- "..." opens a small settings popup: key + mode
            function obj:AddKeybind(kopts)
                kopts = kopts or {}
                holder = holder or newHolder(row, -40)
                widen()
                local mode = kopts.Mode or "Toggle"
                local entry = { Toggle = obj, Name = kopts.Name or opts.Display or opts.Name, Mode = mode, Held = false }

                local dots = DotsButton(holder)
                dots.LayoutOrder = -1

                local pop = Library.Own(New("CanvasGroup", {
                    Visible = false, BackgroundColor3 = T.Popup, BackgroundTransparency = 0.06,
                    Size = UDim2.new(0, 196, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 200, Parent = Root,
                }))
                Corner(pop, 10); Stroke(pop, 0.85); Pad(pop, 12, 8, 12, 8); List(pop, 4)
                Shadow(pop, 10, { Spread = 10, Offset = 3, Strength = 0.4 })

                local kRow = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 1, Parent = pop })
                Text(kRow, "Key", { SizeUDim = UDim2.new(0.5, 0, 1, 0), Color = T.TextDim })
                local kHold = New("Frame", {
                    BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X, Parent = kRow,
                })
                List(kHold, 0, H, RIGHT, VCENTER)

                local mRow = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 2, Parent = pop })
                Text(mRow, "Mode", { SizeUDim = UDim2.new(0.4, 0, 1, 0), Color = T.TextDim })
                local seg = New("Frame", {
                    BackgroundColor3 = T.Section, BackgroundTransparency = 0.3, AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 116, 0, 22), Parent = mRow,
                })
                Corner(seg, 7)
                local modeBtns = {}
                local function paintModes()
                    for m, b in pairs(modeBtns) do
                        local on = (mode == m)
                        b.BackgroundTransparency = on and 0.25 or 1
                        b.TextColor3 = on and T.Text or T.TextDim
                    end
                end
                for idx, m in ipairs({ "Toggle", "Hold" }) do
                    local b = New("TextButton", {
                        Text = m, AutoButtonColor = false, BackgroundColor3 = T.Element, BackgroundTransparency = 1,
                        TextColor3 = T.TextDim, TextSize = 11, FontFace = F_MED,
                        Position = UDim2.new((idx - 1) * 0.5, 2, 0, 2), Size = UDim2.new(0.5, -4, 1, -4), Parent = seg,
                    })
                    Corner(b, 5)
                    modeBtns[m] = b
                    b.MouseButton1Click:Connect(function()
                        mode = m
                        entry.Mode = m
                        paintModes()
                        if Library.RefreshHotkeys then Library.RefreshHotkeys() end
                    end)
                end
                paintModes()

                entry.Bind = AttachKeybind(kHold, flag .. "_Key", kopts.Default or "none",
                    function()
                        if mode == "Toggle" then set(not obj.Value) else entry.Held = true end
                    end,
                    function() if mode == "Hold" then entry.Held = false end end,
                    kopts.Callback)
                function entry:IsActive() return obj.Value and (mode == "Toggle" or entry.Held) end
                Library.Keybinds[flag] = entry

                dots.MouseButton1Click:Connect(function()
                    if Library.Popup and Library.Popup.Frame == pop then ClosePopup() return end
                    local sc = Library.Scale
                    local rp = dots.AbsolutePosition - Root.AbsolutePosition
                    pop.AnchorPoint = Vector2.new(1, 0)
                    pop.Position = UDim2.new(0, (rp.X + dots.AbsoluteSize.X) / sc, 0, (rp.Y + dots.AbsoluteSize.Y + 6) / sc)
                    OpenPopup(pop, dots)
                end)
                if Library.RefreshHotkeys then Library.RefreshHotkeys() end
                return obj
            end

            function obj:AddColorPicker(copts)
                copts = copts or {}
                holder = holder or newHolder(row, -40)
                widen()
                AttachColorPicker(holder, copts.Flag or (flag .. "_Color" .. tostring(#holder:GetChildren())), copts.Default, copts.Callback, copts.NoAlpha)
                return obj
            end

            if opts.Display then Library.Features[flag] = { Toggle = obj, Name = opts.Display, InfoFlag = opts.InfoFlag } end
            Library.Options[flag] = obj
            set(opts.Default or false, false)
            return obj
        end

        -- slider: label | thin slider | editable value box
        function E:AddSlider(opts)
            opts = opts or {}
            local flag = flagOf(opts)
            local min, max, inc = opts.Min or 0, opts.Max or 100, opts.Increment or 1
            local row = Row(RH)
            rowLabel(row, opts, 170)
            local box = New("TextBox", {
                Text = "", ClearTextOnFocus = false, BackgroundColor3 = T.Section, BackgroundTransparency = 0.3,
                TextColor3 = T.Text, TextSize = 12, FontFace = F_MED, AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 46, 0, 24), Parent = row,
            })
            Corner(box, 6)
            local hit = New("Frame", {
                BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -56, 0.5, 0),
                Size = UDim2.new(0, 104, 0, 24), Parent = row,
            })
            local bar = New("Frame", {
                BackgroundColor3 = T.Track, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
                Size = UDim2.new(1, 0, 0, 4), Parent = hit,
            })
            Corner(bar, 2)
            local fill = New("Frame", { BackgroundColor3 = WHITE, Size = UDim2.new(0, 0, 1, 0), Parent = bar })
            Corner(fill, 2)
            AccentGradient(fill, 0.35, math.random(), nil, true)
            local knob = New("Frame", {
                BackgroundColor3 = WHITE, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
                Size = UDim2.new(0, 10, 0, 10), ZIndex = 2, Parent = bar,
            })
            Corner(knob, 5)
            local obj = { Value = min }

            local function set(v, fire)
                v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
                obj.Value = v
                Library.Flags[flag] = v
                local shown = (inc < 1) and string.format("%." .. (opts.Decimals or 2) .. "f", v) or tostring(v)
                box.Text = shown .. (opts.Suffix or "")
                local f = (max > min) and (v - min) / (max - min) or 0
                Tween(fill, { Size = UDim2.new(f, 0, 1, 0) }, 0.08)
                Tween(knob, { Position = UDim2.new(f, 0, 0.5, 0) }, 0.08)
                if fire ~= false and opts.Callback then task.spawn(opts.Callback, v) end
            end
            BindDrag(hit, function(p)
                set(min + (max - min) * math.clamp((p.X - hit.AbsolutePosition.X) / hit.AbsoluteSize.X, 0, 1))
            end)
            box.FocusLost:Connect(function()
                local n = tonumber(box.Text:match("%-?[%d%.]+"))
                if n then set(n) else set(obj.Value, false) end
            end)
            function obj:Set(v) set(v) end
            function obj:Get() return obj.Value end
            Library.Options[flag] = obj
            set(opts.Default or min, false)
            return obj
        end

        -- dropdown: label | compact box on the right
        function E:AddDropdown(opts)
            opts = opts or {}
            local flag = flagOf(opts)
            local values = opts.Values or {}
            local row = Row(RH)
            rowLabel(row, opts, 148)
            local box = New("TextButton", {
                Text = "", AutoButtonColor = false, BackgroundColor3 = T.Section, BackgroundTransparency = 0.3,
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 132, 0, 24), Parent = row,
            })
            Corner(box, 6); Stroke(box, 0.9)
            box.MouseEnter:Connect(function() Tween(box, { BackgroundTransparency = 0.12 }, 0.12) end)
            box.MouseLeave:Connect(function() Tween(box, { BackgroundTransparency = 0.3 }, 0.12) end)
            local cur = Text(box, "", { Position = UDim2.new(0, 10, 0, 0), SizeUDim = UDim2.new(1, -28, 1, 0), Color = T.Text })
            local chev = Chevron(box, UDim2.new(1, -12, 0.5, 0), T.TextDim)

            local list = Library.Own(New("CanvasGroup", {
                Visible = false, BackgroundColor3 = T.Popup, BackgroundTransparency = 0.1, Size = UDim2.new(0, 100, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 200, Parent = Root,
            }))
            Corner(list, 10)
            Stroke(list, 0.82)
            Pad(list, 5, 5, 5, 5); List(list, 2)
            Shadow(list, 10, { Spread = 10, Offset = 3, Strength = 0.4 })

            local obj = { Value = nil }
            local buttons = {}
            local function set(v, fire)
                obj.Value = v
                Library.Flags[flag] = v
                cur.Text = tostring(v)
                for name, b in pairs(buttons) do
                    local on = name == v
                    b.TextColor3 = on and T.Text or T.TextDim
                    b.BackgroundTransparency = on and 0.45 or 1
                end
                if fire ~= false then
                    Shine(box, 6, 0.8)
                    if opts.Callback then task.spawn(opts.Callback, v) end
                end
                if Library.RefreshArray then Library.RefreshArray() end
            end
            for _, name in ipairs(values) do
                local b = New("TextButton", {
                    Text = name, AutoButtonColor = false, BackgroundColor3 = T.Element, BackgroundTransparency = 1,
                    TextColor3 = T.TextDim, TextSize = 12, FontFace = F_MED, TextXAlignment = TLEFT,
                    Size = UDim2.new(1, 0, 0, 26), Parent = list,
                })
                Corner(b, 6); Pad(b, 10, 0, 0, 0)
                b.MouseEnter:Connect(function() if obj.Value ~= name then Tween(b, { BackgroundTransparency = 0.7 }, 0.1) end end)
                b.MouseLeave:Connect(function() Tween(b, { BackgroundTransparency = (obj.Value == name) and 0.45 or 1 }, 0.1) end)
                b.MouseButton1Click:Connect(function() set(name); ClosePopup() end)
                buttons[name] = b
            end
            box.MouseButton1Click:Connect(function()
                if Library.Popup and Library.Popup.Frame == list then ClosePopup() return end
                local sc = Library.Scale
                local w = math.max(box.AbsoluteSize.X / sc, 132)
                list.Size = UDim2.new(0, w, 0, 0)
                list.AnchorPoint = Vector2.new(0.5, 0)
                local rp = box.AbsolutePosition - Root.AbsolutePosition
                list.Position = UDim2.new(0, rp.X / sc + box.AbsoluteSize.X / sc / 2, 0, (rp.Y + box.AbsoluteSize.Y + 4 * sc) / sc)
                Tween(chev, { Rotation = 180 }, 0.25, Enum.EasingStyle.Quint)
                OpenPopup(list, box, function() Tween(chev, { Rotation = 0 }, 0.2, Enum.EasingStyle.Quint) end)
            end)
            function obj:Set(v, fire) set(v, fire) end
            function obj:Get() return obj.Value end
            Library.Options[flag] = obj
            set(opts.Default or values[1] or "", false)
            return obj
        end

        -- buttons / labels / colour / keybind / nav / divider
        function E:AddButton(opts)
            opts = opts or {}
            local row = Row(RH)
            local b = MakeButton(row, opts.Name or "Button", UDim2.new(1, 0, 0, 28), opts.Callback)
            b.AnchorPoint = Vector2.new(0, 0.5)
            b.Position = UDim2.new(0, 0, 0.5, 0)
