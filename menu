            if fadeSaved or (Library.DragFade or 0) <= 0 then return end
            fadeSaved = {}
            local k = math.clamp(Library.DragFade, 0, 0.97)
            local list = main:GetDescendants()
            list[#list + 1] = main
            for _, d in ipairs(list) do
                local props
                if d:IsA("UIStroke") then props = { "Transparency" }
                elseif d:IsA("GuiObject") then
                    props = { "BackgroundTransparency" }
                    if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then props[#props + 1] = "TextTransparency" end
                    if d:IsA("ImageLabel") or d:IsA("ImageButton") then props[#props + 1] = "ImageTransparency" end
                end
                if props then
                    local rec
                    for _, p in ipairs(props) do
                        local v = d[p]
                        if v < 1 then
                            rec = rec or {}
                            rec[p] = v
                            Tween(d, { [p] = v + (1 - v) * k }, 0.18)
                        end
                    end
                    if rec then fadeSaved[d] = rec end
                end
            end
        elseif fadeSaved then
            for d, rec in pairs(fadeSaved) do
                if d.Parent then
                    for p, v in pairs(rec) do Tween(d, { [p] = v }, 0.25) end
                end
            end
            fadeSaved = nil
