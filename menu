    MakeDraggable(wm, wm)

    local order = 0

    -- brand block: logo image, then a thin divider
    local B = Library.Brand
    do
        order += 1
        local brand = New("Frame", {
            Name = "LumaBrand", BackgroundTransparency = 1, LayoutOrder = order, Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X, Parent = wm,
        })
        List(brand, 8, H, LEFT, VCENTER)
        local lumaText = New("TextLabel", {
            Name = "LumaText", BackgroundTransparency = 1, Text = "luma", TextColor3 = WHITE, TextSize = 19,
            FontFace = F_BOLD, TextXAlignment = TLEFT, LayoutOrder = 1,
            Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Parent = brand,
        })
        local lumaGrad = New("UIGradient", { Parent = lumaText })
        local lt0 = os.clock()
        Track(RunService.Heartbeat:Connect(function()
            local A = Library.Theme.Accent
            local A2 = Library.UseAccent2 and Library.Theme.Accent2 or A:Lerp(WHITE, 0.6)
            lumaGrad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, A), ColorSequenceKeypoint.new(0.5, A2), ColorSequenceKeypoint.new(1, A),
            })
            lumaGrad.Offset = Vector2.new(math.sin((os.clock() - lt0) * 1.6), 0)
        end))
        order += 1
        New("Frame", { Name = "LumaDivider", BackgroundColor3 = WHITE, BackgroundTransparency = 0.86, BorderSizePixel = 0, LayoutOrder = order, Size = UDim2.new(0, 1, 0, 16), Parent = wm })

        wmStroke.Color = WHITE
        local sg = New("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, B.Color),
                ColorSequenceKeypoint.new(0.5, B.Color2),
                ColorSequenceKeypoint.new(1, B.Color),
            }),
            Parent = wmStroke,
        })
        local t0 = os.clock()
        Track(RunService.Heartbeat:Connect(function()
            local t = os.clock() - t0
            sg.Rotation = (t * 50) % 360
        end))
    end

    local function group()
        order += 1
        local g = New("Frame", {
            BackgroundTransparency = 1, LayoutOrder = order, Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X, Parent = wm,
        })
        List(g, 7, H, LEFT, VCENTER)
        return g
    end
    local function fmt(n, unit) return ("<b>%s</b> <font color='rgb(150,156,162)'>%s</font>"):format(n, unit) end

    -- fixed = a template string used to reserve width so the pill doesn't jitter while numbers change
    local function pair(iconName, text, fixed)
        local g = group()
        local wic = Icon(g, iconName, 16, WHITE)
        wic.LayoutOrder = 1
        Library.Tint(wic, "ImageColor3")
        local lbl
        if fixed then
            lbl = New("TextLabel", {
                BackgroundTransparency = 1, Text = text, RichText = true, TextColor3 = GLASS.Text, TextSize = TS,
                FontFace = F_SEMI, TextXAlignment = TLEFT, Size = UDim2.new(0, TextW(fixed, TS, F_SEMI), 1, 0), Parent = g,
            })
        else
            lbl = AutoText(g, text, GLASS.Text, TS, F_SEMI)
        end
        lbl.LayoutOrder = 2
        return lbl
    end

    local fps = pair("fpsicon", fmt("0", "FPS"), fmt("000", "FPS"))
    local ms = pair("signal", fmt("0", "MS"), fmt("000", "MS"))
    local clock = pair("clock", "00:00:00", "00:00:00")
    pair("user", user)

    order += 1
    local avatar = New("Frame", {
        BackgroundTransparency = 1, LayoutOrder = order, Size = UDim2.new(0, 26, 0, 26), Parent = wm,
    })
    Corner(avatar, 13)
    local letter = Text(avatar, string.upper(user:sub(1, 1)), { AlignX = TCENTER, Color = Color3.fromRGB(150, 156, 162), Size = 12, Font = F_BOLD })
    task.spawn(function()
        local ok, img = pcall(Players.GetUserThumbnailAsync, Players, LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
        if ok and img and avatar.Parent then
            local pic = New("ImageLabel", { BackgroundTransparency = 1, Image = img, Size = UDim2.new(1, 0, 1, 0), Parent = avatar })
            Corner(pic, 13)
            letter.Visible = false
        end
    end)

    local started, frames, last = os.clock(), 0, os.clock()
    Track(RunService.RenderStepped:Connect(function()
        frames += 1
        local now = os.clock()
        if now - last >= 0.5 then
            local fv = math.floor(frames / (now - last) + 0.5)
            fps.Text = fmt(("%d"):format(fv), "FPS")
            frames, last = 0, now
            local ok, ping = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
            local mv = math.floor((ok and ping or 0) + 0.5)
            ms.Text = fmt(("%d"):format(mv), "MS")
            -- quality colours: green = good, yellow = ok, red = bad
            Tween(fps, { TextColor3 = fv >= 55 and Color3.fromRGB(120, 225, 150) or (fv >= 30 and Color3.fromRGB(245, 205, 90) or Color3.fromRGB(255, 100, 100)) }, 0.25)
            Tween(ms, { TextColor3 = mv <= 0 and GLASS.Text or (mv <= 70 and Color3.fromRGB(120, 225, 150) or (mv <= 140 and Color3.fromRGB(245, 205, 90) or Color3.fromRGB(255, 100, 100))) }, 0.25)
            local e = math.floor(now - started)
            clock.Text = ("%02d:%02d:%02d"):format(e // 3600, (e % 3600) // 60, e % 60)
        end
    end))
    Library.Watermark = wm
    Library.Widgets.Watermark = wm
    return wm
end

-- hotkey list (floating)
-- every row is TWO near-black pills: [toggle][name] or [key][name]  (compact in v4)
function Library:CreateHotkeyList()
    local holder = New("Frame", {
        BackgroundTransparency = 1, Position = UDim2.new(0, 60, 0.55, 0), ZIndex = 100,
        Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, Parent = Root,
    })
    List(holder, 5, V, LEFT)

    local head = Glass(holder, 7, 0.4)
    Shadow(head, 7, { Spread = 6, Offset = 1, Strength = 0.26 })
    head.LayoutOrder = 0
    head.Size = UDim2.new(0, 0, 0, 27)
    head.AutomaticSize = Enum.AutomaticSize.X
    Pad(head, 11, 0, 12, 0)
    List(head, 7, H, LEFT, VCENTER)
    local hic = Icon(head, "list", 15, WHITE)
    hic.LayoutOrder = 1
    Library.Tint(hic, "ImageColor3")
    AutoText(head, "Hotkeys", WHITE, 14, F_BOLD).LayoutOrder = 2
    MakeDraggable(head, holder)

    local rows, known, lastSig = {}, {}, nil
    local function pill(parent, order, pad)
        local p = Glass(parent, 6, 0.4)
        Shadow(p, 6, { Spread = 5, Offset = 1, Strength = 0.24 })
        p.LayoutOrder = order
        p.Size = UDim2.new(0, 0, 0, 24)
        p.AutomaticSize = Enum.AutomaticSize.X
        Pad(p, pad or 10, 0, pad or 10, 0)
        List(p, 6, H, LEFT, VCENTER)
        return p
    end

    function Library.RefreshHotkeys()
        local entries = {}
        for _, e in pairs(Library.Keybinds) do
            if e.Toggle.Value and e.Bind and e.Bind.Key ~= "none" then entries[#entries + 1] = e end
        end
        table.sort(entries, function(a, b) return a.Name < b.Name end)
        local ids = {}
        for _, e in ipairs(entries) do ids[#ids + 1] = e.Name .. ":" .. e.Bind.Key .. ":" .. e.Mode end
        local sig = table.concat(ids, ",")
        if sig == lastSig then return end
        lastSig = sig

        for _, r in ipairs(rows) do r:Destroy() end
        rows = {}
        local nowKnown = {}
        for idx, e in ipairs(entries) do
            local id = e.Name .. e.Bind.Key
            nowKnown[id] = true
            local row = New("Frame", { BackgroundTransparency = 1, LayoutOrder = idx, Size = UDim2.new(0, 0, 0, 24), AutomaticSize = Enum.AutomaticSize.X, Parent = holder })
            List(row, 5, H, LEFT, VCENTER)
            local first
            if e.Mode == "Hold" then
                first = pill(row, 1)
                AutoText(first, Cap(e.Bind.Key), GLASS.Text, 13, F_MED)
            else
                first = pill(row, 1, 8)
                local track = New("Frame", { BackgroundColor3 = Color3.fromRGB(236, 236, 240), Size = UDim2.new(0, 18, 0, 10), Parent = first })
                Library.Tint(track, "BackgroundColor3")
                Corner(track, 5)
                local knob = New("Frame", {
                    BackgroundColor3 = Color3.fromRGB(62, 62, 70), Size = UDim2.new(0, 6, 0, 6), AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -2, 0.5, 0), Parent = track,
                })
                Corner(knob, 3)
            end
            local name = pill(row, 2)
            AutoText(name, e.Name, GLASS.Text, 13, F_MED)
            if not known[id] then
                Shine(first, 6)
                Shine(name, 6)
            end
            rows[#rows + 1] = row
        end
        known = nowKnown
    end

    Library.Hotkeys = holder
    Library.Widgets.Hotkeys = holder
    Library.RefreshHotkeys()
    return holder
end

-- array list
-- Styles: "Clean" (default, like the real one), "Bar", "Bracket", "Underline", "Glow"
function Library:CreateArrayList()
    local holder = New("Frame", {
        BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 64), ZIndex = 100,
        Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, Parent = Root,
    })
    List(holder, 6, V, RIGHT)
    local cache, building, again = {}, false, false
    local DIM = "rgb(150,156,162)"

    local function buildEntry(e, idx)
        local T = Library.Theme
        local cfg = Library.ArrayCfg
        local ts, style = cfg.TextSize, cfg.Style
        local plain = e.Name .. (e.Info and (" " .. e.Info) or "")
        local rich = e.Name .. (e.Info and (" <font color='" .. DIM .. "'>" .. e.Info .. "</font>") or "")
        if style == "Bracket" then
            local ac = cfg.AccentLine and Rgb(Library.GetAccent2()) or DIM
            rich = ("<font color='%s'>[</font> %s <font color='%s'>]</font>"):format(ac, rich, ac)
            plain = "[ " .. plain .. " ]"
        end
        local p, st = Glass(holder, 7, 0.45)
        Shadow(p, 7, { Spread = 6, Offset = 1, Strength = 0.3 })
        p.LayoutOrder = idx
        p.Size = UDim2.new(0, 0, 0, ts + 13)
        p.AutomaticSize = Enum.AutomaticSize.X
        Pad(p, 10, 0, (style == "Bar" and cfg.AccentLine) and 16 or 10, 0)
        if not cfg.Background then p.BackgroundTransparency = 1 end
        local lbl = AutoText(p, rich, cfg.Gradient and WHITE or GLASS.Text, ts, F_MED)
        local grad
        if cfg.Gradient then
            -- colours are written every frame by the flow updater below (one gradient across the whole list)
            grad = New("UIGradient", { Rotation = 90, Parent = lbl })
        end
        if cfg.AccentLine and style ~= "Clean" then
            local phase = idx * 0.2
            if style == "Bar" then
                local b = New("Frame", {
                    BackgroundColor3 = WHITE, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -5, 0.5, 0), Size = UDim2.new(0, 2, 0, ts - 2), Parent = p,
                })
                Corner(b, 1)
                AccentGradient(b, 0.45, phase, 90)
            elseif style == "Underline" then
                local u = New("Frame", {
                    BackgroundColor3 = WHITE, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1),
                    Position = UDim2.new(0, 10, 1, -2), Size = UDim2.new(0, TextW(plain, ts, F_MED), 0, 2), Parent = p,
                })
                Corner(u, 1)
                AccentGradient(u, 0.45, phase)
            elseif style == "Glow" then
                -- soft halo (stacked fills, no stroke). The pill is made near-opaque so the halo only shows outside it.
                -- (halo is tighter now: Spread 5 / Strength 0.45, was 9 / 0.5)
                p.BackgroundTransparency = 0.1
                Shadow(p, 7, { Spread = 5, Offset = 0, Strength = 0.45, Color = T.Accent:Lerp(Library.GetAccent2(), 0.5) })
            end
        end
        return p, lbl, grad
    end

    local function refresh()
        local cfg = Library.ArrayCfg
        local list = {}
        for _, f in pairs(Library.Features) do
            if f.Toggle.Value then
                local info = f.InfoFlag and Library.Flags[f.InfoFlag]
                list[#list + 1] = { Name = f.Name, Info = (info ~= nil) and tostring(info) or nil }
            end
        end
        table.sort(list, function(a, b)
            local la, lb = #a.Name + #(a.Info or ""), #b.Name + #(b.Info or "")
            if la ~= lb then return la > lb end
            return a.Name < b.Name
        end)
        local seen = {}
        for idx, e in ipairs(list) do
            local sig = table.concat({ e.Name, tostring(e.Info), cfg.TextSize, tostring(cfg.Background), tostring(cfg.AccentLine), cfg.Style, tostring(cfg.Gradient) }, "|")
            local c = cache[e.Name]
            if c and c.Sig == sig and c.Frame.Parent then
                c.Frame.LayoutOrder = idx
            else
                if c then c.Frame:Destroy() end
                local f, lbl, grad = buildEntry(e, idx)
                cache[e.Name] = { Frame = f, Sig = sig, Label = lbl, Grad = grad }
                Shine(f, 7, 0.7)
            end
            seen[e.Name] = true
        end
        for name, c in pairs(cache) do
            if not seen[name] then c.Frame:Destroy(); cache[name] = nil end
        end
    end

    function Library.RefreshArray(force)
        if force == true then
            for _, c in pairs(cache) do c.Sig = "" end
        end
        if building then again = true return end
        building = true
        task.spawn(function()
            repeat
                again = false
                local ok, err = pcall(refresh)
                if not ok then warn("[Matcha] array list: " .. tostring(err)) end
            until not again or Library.Dead
            building = false
        end)
    end

    -- ONE continuous theme gradient across every entry, flowing bottom -> top.
    -- Each label gets the slice of the shared palette that matches where it sits in the list.
    local gAcc = 0
    Track(RunService.RenderStepped:Connect(function(dt)
        if not holder.Visible or not Library.ArrayCfg.Gradient then return end
        gAcc += dt
        if gAcc < 1 / 40 then return end
        gAcc = 0
        local sc, T = Library.Scale, Library.Theme
        local a, b = T.Accent, Library.GetAccent2()
        -- both accents identical (e.g. default white/white)? fade towards a darker shade so the flow is still visible
        if (a.R - b.R) ^ 2 + (a.G - b.G) ^ 2 + (a.B - b.B) ^ 2 < 0.02 then b = a:Lerp(Color3.new(0, 0, 0), 0.5) end
        local top = holder.AbsolutePosition.Y
        local period = math.max(holder.AbsoluteSize.Y / sc, 120)
        local phase = AnimTime * Library.ArrayCfg.GradSpeed
        for _, c in pairs(cache) do
            local l, g = c.Label, c.Grad
            if l and g and l.Parent and g.Parent then
                local y0 = (l.AbsolutePosition.Y - top) / sc
                local h = l.AbsoluteSize.Y / sc
                local keys = {}
                for k = 0, 5 do
                    local x = (y0 + h * k / 5) / period + phase -- phase grows => pattern moves UP
                    local m = 0.5 - 0.5 * math.cos(x * 2 * math.pi)
                    keys[#keys + 1] = ColorSequenceKeypoint.new(k / 5, a:Lerp(b, m))
                end
                g.Color = ColorSequence.new(keys)
            end
        end
    end))

    MakeDraggable(holder, holder)
    Library.Widgets.ArrayList = holder
    Library.RefreshArray()
    return holder
end

-- keystrokes (WASD + space + LMB/RMB with CPS)
-- Intentionally NO shadow here (matches the real one).
function Library:CreateKeystrokes()
    local KEY, G = 40, 4
    local W = KEY * 3 + G * 2 -- 128
    local f = New("Frame", {
        BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -40),
        Size = UDim2.new(0, W, 0, 156), Visible = false, ZIndex = 100, Parent = Root,
    })
    local keys = {}
    local function key(id, text, x, y, w, h)
        local k, ks = Glass(f, 6, 0.15, 0.93)
        k.Position, k.Size = UDim2.new(0, x, 0, y), UDim2.new(0, w, 0, h)
        local l = Text(k, text, { AlignX = TCENTER, Color = GLASS.KeyText, Size = 13, Font = F_BOLD })
        keys[id] = { Frame = k, Label = l, Stroke = ks }
        return k
    end
    key("W", "W", KEY + G, 0, KEY, KEY)
    key("A", "A", 0, KEY + G, KEY, KEY)
    key("S", "S", KEY + G, KEY + G, KEY, KEY)
    key("D", "D", (KEY + G) * 2, KEY + G, KEY, KEY)
    local sy = (KEY + G) * 2
    local space = key("Space", "", 0, sy, W, 16)
    local dash = New("Frame", {
        BackgroundColor3 = Color3.fromRGB(205, 208, 212), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 24, 0, 2), Parent = space,
    })
    Corner(dash, 1)
    local my = sy + 20
    local mw = (W - G) / 2
    key("LMB", "LMB", 0, my, mw, 30)
    key("RMB", "RMB", mw + G, my, mw, 30)

    local cpsL, cpsR = {}, {}
    local function cpsLabel(x)
        return Text(f, "0 CPS", {
            Position = UDim2.new(0, x, 0, my + 33), SizeUDim = UDim2.new(0, mw, 0, 12),
            AlignX = TCENTER, Size = 10, Color = Color3.fromRGB(228, 230, 233), Font = F_BOLD,
        })
    end
    local lblL, lblR = cpsLabel(0), cpsLabel(mw + G)

    -- pressed look: translucent grey fill + light outline + white text (like the real widget)
    local PRESSED = Color3.fromRGB(148, 150, 155)
    local function paint(id, down)
        local k = keys[id]
        if not k then return end
        Tween(k.Frame, { BackgroundColor3 = down and Library.Theme.Accent:Lerp(Color3.new(0, 0, 0), 0.42) or GLASS.Near, BackgroundTransparency = down and 0.2 or 0.15 }, 0.08)
        Tween(k.Stroke, { Transparency = down and 0.3 or 0.93 }, 0.08)
        Tween(k.Label, { TextColor3 = down and WHITE or GLASS.KeyText }, 0.08)
    end
    local function idOf(i)
        local ut = i.UserInputType
        if ut == Enum.UserInputType.Keyboard then
            local n = i.KeyCode.Name
            if keys[n] and n ~= "LMB" and n ~= "RMB" then return n end
        elseif ut == Enum.UserInputType.MouseButton1 then return "LMB"
        elseif ut == Enum.UserInputType.MouseButton2 then return "RMB" end
    end
    Track(UIS.InputBegan:Connect(function(i)
        local id = idOf(i)
        if not id then return end
        paint(id, true)
        if id == "LMB" then cpsL[#cpsL + 1] = os.clock() elseif id == "RMB" then cpsR[#cpsR + 1] = os.clock() end
    end))
    Track(UIS.InputEnded:Connect(function(i)
        local id = idOf(i)
        if id then paint(id, false) end
    end))

    local acc = 0
    Track(RunService.Heartbeat:Connect(function(dt)
        acc += dt
        if acc < 0.1 then return end
        acc = 0
        local now = os.clock()
        while cpsL[1] and now - cpsL[1] > 1 do table.remove(cpsL, 1) end
        while cpsR[1] and now - cpsR[1] > 1 do table.remove(cpsR, 1) end
        lblL.Text = #cpsL .. " CPS"
        lblR.Text = #cpsR .. " CPS"
    end))

    MakeDraggable(f, f)
    Library.Widgets.Keystrokes = f
    return f
end

