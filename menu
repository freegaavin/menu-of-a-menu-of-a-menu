local function Tween(o, props, t, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function Inside(frame, pos)
    local p, s = frame.AbsolutePosition, frame.AbsoluteSize
    return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
end

-- Pointer position in the same space as AbsolutePosition (the ScreenGui ignores the GUI inset,
-- and InputObject.Position does NOT, so we always use GetMouseLocation for mouse input).
local function Pt(i)
    if i and i.UserInputType == Enum.UserInputType.Touch then return Vector2.new(i.Position.X, i.Position.Y) end
    return UIS:GetMouseLocation()
end

local function BindDrag(frame, cb)
    local dragging = false
    frame.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            if Library.WindowDragging then return end -- never grab a slider while the window is being moved
            dragging = true
            Library.ElementDragging = true            -- ...and never move the window while a slider is held
            cb(Pt(i))
        end
    end)
    Track(UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            cb(Pt(i))
        end
    end))
    Track(UIS.InputEnded:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            Library.ElementDragging = false
        end
    end))
end

local function KeyName(input)
    local ut = input.UserInputType
    if ut == Enum.UserInputType.MouseButton1 then return "lmb" end
    if ut == Enum.UserInputType.MouseButton2 then return "rmb" end
    if ut == Enum.UserInputType.MouseButton3 then return "mmb" end
    if input.KeyCode ~= Enum.KeyCode.Unknown then
        local n = input.KeyCode.Name
        local map = { LeftControl = "control", RightControl = "rcontrol", LeftShift = "shift", RightShift = "rshift",
            LeftAlt = "alt", RightAlt = "ralt", Insert = "ins", Delete = "del", Return = "enter", Backspace = "bksp" }
        return (map[n] or n):lower()
    end
end

