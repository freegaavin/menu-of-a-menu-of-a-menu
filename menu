    local cfgTok = 0
    local function closeCfg()
        if not presets.Visible then return end
        cfgTok += 1
        local my = cfgTok
        Tween(presets, { GroupTransparency = 1 }, 0.14)
        Tween(presetsScale, { Scale = 0.96 }, 0.14)
        task.delay(0.15, function() if cfgTok == my then presets.Visible = false end end)
    end
    local function openCfg()
        cfgTok += 1
        if not Library.CfgPlaced then -- first time: dock it next to the window (or inside it when there's no room)
            Library.CfgPlaced = true
            local sc = Library.Scale
            local mp = main.AbsolutePosition - Root.AbsolutePosition
            local x = (mp.X + main.AbsoluteSize.X) / sc + 12
            if (x + 372) * sc > Root.AbsoluteSize.X then x = mp.X / sc + SIDE + 8 end
            presets.Position = UDim2.new(0, x, 0, mp.Y / sc + 8)
        end
        search.Text = ""
        nameBox.Text = ""
        rebuildPresets()
        presets.GroupTransparency = 1
        presetsScale.Scale = 0.96
        presets.Visible = true
        BringToFront(presets)
        Tween(presets, { GroupTransparency = 0 }, 0.2)
        Tween(presetsScale, { Scale = 1 }, 0.28, Enum.EasingStyle.Quint)
    end
    iconBtn(-82, "x", closeCfg)
    W.CloseConfigs = closeCfg
    MakeDraggable(cfgHandle, presets)
    cfgBtn.MouseButton1Click:Connect(function()
        if presets.Visible and presets.GroupTransparency < 0.5 then closeCfg() else openCfg() end
    end)

    -- show / hide / destroy
    -- open: scale up + slide up + blur in.  close: scale down + slide down + blur out, then hidden.
    local uiScale = New("UIScale", { Scale = 1, Parent = main })
    local shown, closing, closeTok, closeRest = false, false, 0, nil
    -- close fade: everything in the window fades out while it shrinks; values are restored once it is hidden
    local closeSaved, closeTweens = nil, {}
    local function restoreClose()
        for _, tw in ipairs(closeTweens) do pcall(function() tw:Cancel() end) end
        closeTweens = {}
        if not closeSaved then return end
        for d, rec in pairs(closeSaved) do
            if d.Parent then
                for p, v in pairs(rec) do pcall(function() d[p] = v end) end
            end
        end
        closeSaved = nil
    end
    local function fadeOutWindow(t)
        restoreClose()
        closeSaved = {}
        local list = main:GetDescendants()
        list[#list + 1] = main
        for _, d in ipairs(list) do
            local props
            if d:IsA("UIStroke") then props = { "Transparency" }
            elseif d:IsA("GuiObject") and d.Visible then
                props = { "BackgroundTransparency" }
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then props[#props + 1] = "TextTransparency" end
                if d:IsA("ImageLabel") or d:IsA("ImageButton") then props[#props + 1] = "ImageTransparency" end
            end
            if props then
                local rec, goal
                for _, p in ipairs(props) do
                    local v = d[p]
                    if v < 1 then
                        rec, goal = rec or {}, goal or {}
                        rec[p] = v
                        goal[p] = 1
                    end
                end
                if rec then
                    closeSaved[d] = rec
                    closeTweens[#closeTweens + 1] = Tween(d, goal, t, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                end
            end
        end
    end
    function W:SetVisible(v)
        v = v and true or false
        closeTok += 1
        local my = closeTok
        local st = RevealState[main]
        if v then
            if shown then return end
            shown = true
            if closing then -- re-opened mid-close: snap back to the resting spot and treat as hidden
                closing = false
                if closeRest then main.Position = closeRest end
                main.Visible = false
            end
            restoreClose()
            uiScale.Scale = 0.93
            Reveal(main, true, 22)
            Tween(uiScale, { Scale = 1 }, 0.38, Enum.EasingStyle.Quint)
            BringToFront(main)
            Blur.Enabled = Library.BlurOn
            if Library.BlurOn then
                Blur.Size = 0
                Tween(Blur, { Size = Library.BlurSize }, 0.4)
            end
            Library:RefreshBackdrop()
        else
            if not shown or not main.Visible then shown = false return end
            shown = false
            ClosePopup()
            if W.CloseConfigs then W.CloseConfigs() end
            if W.StopDrag then W.StopDrag() end
            if st and st.Tween then -- cut a running open animation short
                st.Tween:Cancel(); st.Tween = nil
                if st.Rest then main.Position = st.Rest end
            end
            closing, closeRest = true, main.Position
            Tween(main, { Position = closeRest + UDim2.new(0, 0, 0, 12) }, 0.26, Enum.EasingStyle.Cubic, Enum.EasingDirection.In)
            Tween(uiScale, { Scale = 0.9 }, 0.26, Enum.EasingStyle.Cubic, Enum.EasingDirection.In)
            fadeOutWindow(0.24)
            if Library.BlurOn then Tween(Blur, { Size = 0 }, 0.26) end
            task.delay(0.27, function()
                if closeTok ~= my then return end
                closing = false
                main.Visible = false
                restoreClose()
                main.Position = closeRest
                uiScale.Scale = 1
                Blur.Enabled = false
                if st then st.Rest = main.Position end
                Library:RefreshBackdrop()
            end)
        end
    end
    function W:Toggle() W:SetVisible(not shown) end

    W.KeyConn = Track(UIS.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode == Library.MenuKey then W:Toggle() end
    end))

    function W:Destroy()
        if W.KeyConn then W.KeyConn:Disconnect() end
        pcall(function() ghost:Destroy() end)
        for i = #Library.Panels, 1, -1 do
            if Library.Panels[i] == main then table.remove(Library.Panels, i) end
        end
        main:Destroy()
    end

    Library.Window = W
    return W
end

