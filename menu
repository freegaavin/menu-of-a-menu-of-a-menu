-- If you have the real TTF (put it in your executor's workspace folder):
--   getgenv().MatchaFontFile = "Matcha/font.ttf"
-- Roblox needs a family json, so we generate one that points every weight at that file.
local function CustomFamily(path, boldPath)
    if not (path and writefile and getcustomasset and isfile and isfile(path)) then return nil end
    local ok, result = pcall(function()
        local asset = getcustomasset(path)
        local boldAsset = (boldPath and isfile(boldPath)) and getcustomasset(boldPath) or asset
        local faces = {}
        for _, w in ipairs({ 100, 200, 300, 400, 500, 600, 700, 800, 900 }) do
            faces[#faces + 1] = { name = tostring(w), weight = w, style = "normal", assetId = (w >= 600) and boldAsset or asset }
        end
        local jsonPath = "MatchaFont_family.json"
        writefile(jsonPath, game:GetService("HttpService"):JSONEncode({ name = "MatchaCustom", faces = faces }))
        return getcustomasset(jsonPath)
    end)
    return ok and result or nil
end

