-- text width measurement (cached). Used wherever we need FIXED sizes instead of AutomaticSize.
local MeasureCache = {}
local function Measure(text, size, font)
    text = (tostring(text):gsub("<[^>]+>", ""))
    local key = size .. "|" .. tostring(font.Weight) .. "|" .. text
    local hit = MeasureCache[key]
    if hit then return hit end
    local w
    pcall(function()
        local p = Instance.new("GetTextBoundsParams")
        p.Text, p.Font, p.Size, p.Width = text, font, size + Library.TextBoost, 10000
        w = TextService:GetTextBoundsAsync(p).X
    end)
    if not w then w = #text * size * 0.58 end
    w = math.ceil(w)
    MeasureCache[key] = w
    return w
end

