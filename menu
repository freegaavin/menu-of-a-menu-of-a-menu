-- background image
-- Library:SetBackgroundImage(12345678)            -- Roblox image asset ID (number, "rbxassetid://123" or a full url); "" clears it
-- Library:SetBackgroundOpacity(0..1)              -- 1 = fully visible image
-- Library:SetBackgroundFit("Crop"|"Fit"|"Stretch"|"Tile")
-- Note: use the IMAGE id of the asset (a Decal's id shows nothing in many games - get the image id from the Decal).
Library.BgImageId = ""
Library.BgOpacity = 0.75 -- the sidebar and cards sit on top of the image, so a low value is hard to see
local BG_FITS = { Crop = Enum.ScaleType.Crop, Fit = Enum.ScaleType.Fit, Stretch = Enum.ScaleType.Stretch, Tile = Enum.ScaleType.Tile }

function Library:SetBackgroundImage(id)
    local img = Library.Window and Library.Window.BgImage
    if not img then return false end
    local s = (tostring(id or ""):gsub("%s+", ""))
    Library.BgImageId = s
    if s == "" then
        img.Image = ""
        img.Visible = false
        return true
    end
    local url
    if s:find("://", 1, true) then
        url = s
    elseif s:match("^%d+$") then
        url = "rbxassetid://" .. s
    elseif s:match("%.%w+$") and isfile and getcustomasset and isfile(s) then
        -- a local image file from your executor's workspace folder, e.g. "Matcha/bg.png"
        local ok, a = pcall(getcustomasset, s)
        if ok then url = a end
    else
        local n = s:match("%d+")
        url = n and ("rbxassetid://" .. n) or nil
    end
    if not url then
        Library:Notify("Background", "That isn't a valid asset ID", 3)
        return false
    end
    img.Image = url
    img.ImageTransparency = 1
    img.Visible = true
    Tween(img, { ImageTransparency = 1 - Library.BgOpacity }, 0.4)

    local my = (Library.BgToken or 0) + 1
    Library.BgToken = my
    task.spawn(function()
        -- a Decal id renders nothing in an ImageLabel: if the asset turns out to be a Decal, swap in its real image
        if url:match("^rbxassetid://%d+$") and game.GetObjects then
            local ok, objs = pcall(function() return game:GetObjects(url) end)
            local o = ok and type(objs) == "table" and objs[1] or nil
            if o and (o:IsA("Decal") or o:IsA("Texture")) and o.Texture ~= "" and Library.BgToken == my then
                img.Image = o.Texture
            end
            if o then pcall(function() o:Destroy() end) end
        end
        if Library.BgToken ~= my then return end
        pcall(function() game:GetService("ContentProvider"):PreloadAsync({ img }) end)
        if Library.BgToken == my and not img.IsLoaded then
            Library:Notify("Background", "Image failed to load - use an Image ID (not a Decal ID) of a public, approved asset", 5)
        end
    end)
    return true
end

function Library:SetBackgroundOpacity(a)
    Library.BgOpacity = math.clamp(tonumber(a) or Library.BgOpacity, 0, 1)
    local img = Library.Window and Library.Window.BgImage
    if img and img.Visible then Tween(img, { ImageTransparency = 1 - Library.BgOpacity }, 0.15) end
end

function Library:SetBackgroundFit(name)
    local img = Library.Window and Library.Window.BgImage
    if img and BG_FITS[name] then img.ScaleType = BG_FITS[name] end
end

