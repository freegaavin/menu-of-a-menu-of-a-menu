    Color = Color3.fromRGB(150, 176, 236),  -- periwinkle accent
    Color2 = Color3.fromRGB(100, 130, 212),
}

local function LumaLogoImage()
    local l = Library.Brand.Logo
    if not l or l == "" then return nil end
    l = tostring(l)
    if l:find("://", 1, true) then return l end
    if l:match("^%d+$") then return "rbxassetid://" .. l end
    if isfile and getcustomasset and isfile(l) then
        local ok, a = pcall(getcustomasset, l)
        if ok then return a end
    end
    return nil
end

-- a drawn blue "L" on a dark rounded tile (or your logo image if Library.Brand.Logo is set). Not used by default any more.
function Library.MakeLumaLogo(parent, size)
    local B = Library.Brand
    local box = New("Frame", { BackgroundColor3 = Color3.fromRGB(12, 13, 18), BorderSizePixel = 0, Size = UDim2.fromOffset(size, size), Parent = parent })
    local rad = math.floor(size * 0.28)
    Corner(box, rad)
    New("UIStroke", { Color = WHITE, Transparency = 0.8, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = box })
    local img = LumaLogoImage()
    if img then
        local il = New("ImageLabel", { BackgroundTransparency = 1, Image = img, Size = UDim2.new(1, 0, 1, 0), ScaleType = Enum.ScaleType.Fit, Parent = box })
        Corner(il, rad)
        return box
    end
    local function bar(x, y, w, h)
        local b = New("Frame", { BackgroundColor3 = WHITE, BorderSizePixel = 0, Position = UDim2.new(x, 0, y, 0), Size = UDim2.new(w, 0, h, 0), Parent = box })
        Corner(b, math.max(1, math.floor(size * 0.07)))
        New("UIGradient", { Color = ColorSequence.new(B.Color, B.Color2), Rotation = 90, Parent = b })
    end
    bar(0.30, 0.22, 0.16, 0.56)
    bar(0.30, 0.62, 0.42, 0.16)
    return box
end

