local IconLabels = {}
local function ApplyIcon(img, name)
    if not name or name == "" then return end
    if name:find("rbxasset", 1, true) or name:find("http", 1, true) or name:match("^%d+$") then
        img.Image = name:match("^%d+$") and ("rbxassetid://" .. name) or name
        return
    end
    local mod = Library.IconModule
    if not mod then return end
    for _, n in ipairs(ICON_ALIASES[name] or { name }) do
        local ok, a = pcall(mod.GetAsset, n)
        if ok and a and a.Url then
            img.Image = a.Url
            if a.ImageRectSize then img.ImageRectSize = a.ImageRectSize end
            if a.ImageRectOffset then img.ImageRectOffset = a.ImageRectOffset end
            return
        end
    end
end

local function Icon(parent, name, size, color)
    local img = New("ImageLabel", {
        BackgroundTransparency = 1, Image = "", ImageColor3 = color or Library.Theme.TextDim,
        ScaleType = Enum.ScaleType.Fit, Size = UDim2.new(0, size or 12, 0, size or 12), Parent = parent,
    })
    if name and name ~= "" then
        IconLabels[#IconLabels + 1] = { Img = img, Name = name }
        ApplyIcon(img, name)
    end
    return img
end

function Library:SetIcon(img, name)
    IconLabels[#IconLabels + 1] = { Img = img, Name = name }
    ApplyIcon(img, name)
end

function Library:RefreshIcons()
    for i = #IconLabels, 1, -1 do
        local e = IconLabels[i]
        if e.Img.Parent then ApplyIcon(e.Img, e.Name) else table.remove(IconLabels, i) end
    end
end

-- bring your own icon module: needs :GetAsset(name) -> { Url, ImageRectSize, ImageRectOffset }
function Library:SetIconModule(mod)
    Library.IconModule = mod
    Library:RefreshIcons()
end

