    -- pages (a tab can own several; each one is its own scrolling two-column page)
    local pageSeq = 0 -- creation order: decides which way a page slides when you switch tabs
    local function newPage(def, tab)
        local grp = New("CanvasGroup", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Visible = false, Parent = pages })
        local sf = New("ScrollingFrame", {
            BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0, Size = UDim2.new(1, 0, 1, 0),
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = grp,
        })
        Pad(sf, 2, 2, 2, 8)
        List(sf, 0)
        local inner = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = sf })
        List(inner, 14, H, LEFT, TOP)
        local function col()
            local c = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.5, -7, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = inner })
            List(c, 0)
            return c
        end
        local c1, c2 = col(), col()
        pageSeq += 1
        local pg = { Name = def.Name, Icon = def.Icon, Grp = grp, Cols = { c1, c2 }, W = { 0, 0 }, Single = def.Single, Tab = tab, Seq = pageSeq }
        if pg.Single then
            -- one column on the left; the right half is kept free for a preview panel
            sf.Size = UDim2.new(0.5, -7, 1, 0)
            c1.Size = UDim2.new(1, 0, 0, 0)
            c2.Visible = false
        end
        pg.Groups = {}
        -- switch between one column (right half kept free) and two balanced columns, re-sorting every section
        function pg.SetLayout(single, skipSize)
            pg.Single = single and true or false
            if pg.Single then
                c1.Size = UDim2.new(1, 0, 0, 0); c2.Visible = false
            else
                c1.Size = UDim2.new(0.5, -7, 0, 0); c2.Visible = true
            end
            if not skipSize then sf.Size = pg.Single and UDim2.new(0.5, -7, 1, 0) or UDim2.new(1, 0, 1, 0) end
            pg.W = { 0, 0 }
            for i, g in ipairs(pg.Groups) do
                local col, idx = pg.Pick()
                g.Head.Parent, g.Card.Parent, g.Gap.Parent = col, col, col
                g.Head.LayoutOrder, g.Card.LayoutOrder, g.Gap.LayoutOrder = i * 3, i * 3 + 1, i * 3 + 2
                local h = 0
                if not g.IsCollapsed() then
                    h = g.Card.AbsoluteSize.Y / Library.Scale
                    if h <= 0 then h = #g.Card:GetChildren() * 36 end
                end
                pg.W[idx] += 32 + h
            end
        end
        function pg.Pick()
            local i = 1
            if not pg.Single and pg.W[2] < pg.W[1] then i = 2 end
            return pg.Cols[i], i
        end
        return pg
    end

    -- navigation
    local selectTab
    local navAnimate = false -- true only for the rebuild that follows a tab switch (animates the selected item)
    local function rebuildNav()
        for _, c in ipairs(nav:GetChildren()) do c:Destroy() end
        List(nav, 3)
        local gidx, count, list = {}, 0, {}
        for _, t in ipairs(W.Tabs) do
            if not gidx[t.Group] then count += 1; gidx[t.Group] = count end
            if not t.Hidden then list[#list + 1] = t end
        end
        table.sort(list, function(a, b)
            return gidx[a.Group] * 1000 + (a.Order or a.Index) < gidx[b.Group] * 1000 + (b.Order or b.Index)
        end)

        local order = 0
        local function spacer(h)
            order += 1
            New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h), LayoutOrder = order, Parent = nav })
        end
        -- state: "on" (selected) | "soft" (parent of the selected page) | "off"
        local function navItem(label, iconName, sub, state, onClick)
            order += 1
            local holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = order, Parent = nav })
            local item = New("TextButton", {
                Text = "", AutoButtonColor = false, BackgroundColor3 = T.Element,
                BackgroundTransparency = (state == "on") and 0.3 or ((state == "soft") and 0.65 or 1),
                Position = UDim2.new(0, sub and 12 or 0, 0, 0), Size = UDim2.new(1, sub and -12 or 0, 1, 0), Parent = holder,
            })
            Corner(item, 8)
            if state == "on" then
                local mark = New("Frame", {
                    BackgroundColor3 = WHITE, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.new(0, 3, 0, navAnimate and 0 or 16), Parent = item,
                })
                Corner(mark, 2)
                AccentGradient(mark, 0.4, 0, 90, true)
                if navAnimate then
                    -- the highlight fades in and the marker grows out of the middle
                    item.BackgroundTransparency = 1
                    Tween(item, { BackgroundTransparency = 0.3 }, 0.28, Enum.EasingStyle.Quint)
                    Tween(mark, { Size = UDim2.new(0, 3, 0, 16) }, 0.4, Enum.EasingStyle.Back)
                end
            elseif state == "soft" and navAnimate then
                item.BackgroundTransparency = 1
                Tween(item, { BackgroundTransparency = 0.65 }, 0.28, Enum.EasingStyle.Quint)
            end
            local bright = state ~= "off"
            local ic = Icon(item, iconName, 16, bright and T.Text or T.TextDim)
            ic.AnchorPoint = Vector2.new(0, 0.5)
            ic.Position = UDim2.new(0, 10, 0.5, 0)
            Text(item, label, {
                Position = UDim2.new(0, 37, 0, 0), SizeUDim = UDim2.new(1, -40, 1, 0),
                Color = bright and T.Text or T.TextDim, Font = bright and F_SEMI or F_MED,
            })
            if state == "off" then
                item.MouseEnter:Connect(function() Tween(item, { BackgroundTransparency = 0.7 }, 0.1) end)
                item.MouseLeave:Connect(function() Tween(item, { BackgroundTransparency = 1 }, 0.1) end)
            end
            item.MouseButton1Click:Connect(onClick)
        end

        local lastGroup
        for _, t in ipairs(list) do
            if t.Group ~= lastGroup then
                if lastGroup then spacer(3) end
                lastGroup = t.Group
                order += 1
                local gl = New("TextLabel", {
                    BackgroundTransparency = 1, Text = t.Group, TextColor3 = Color3.fromRGB(122, 124, 140), TextSize = 11, FontFace = F_SEMI,
                    TextXAlignment = TLEFT, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = order, Parent = nav,
                })
                Pad(gl, 12, 0, 0, 0)
            end
            if t.Flatten then
                -- the tab itself is hidden; its pages are the items (like Aimbot / Silent / Trigger)
                for _, pg in ipairs(t.Pages) do
                    navItem(pg.Name, pg.Icon or t.IconName, false, (W.CurrentPage == pg) and "on" or "off", function() selectTab(t, pg) end)
                end
            else
                local current = (W.Current == t)
                local expanded = current and #t.Pages > 1
                navItem(t.Name, t.IconName, false, current and (expanded and "soft" or "on") or "off", function()
                    if W.Current ~= t then selectTab(t) end
                end)
                if expanded then
                    -- sub-pages unfold under the tab, like Visuals > Players / Extras
                    for _, pg in ipairs(t.Pages) do
                        navItem(pg.Name, pg.Icon or t.IconName, true, (W.CurrentPage == pg) and "on" or "off", function()
                            if W.CurrentPage ~= pg then selectTab(t, pg) end
                        end)
                    end
                end
            end
        end
    end

    -- Tab switch animation: the old page fades out and slides away, the new page slides in from the direction you
    -- navigated (down the sidebar = from below, up = from above), and the selected sidebar item fades in.
    function selectTab(tab, pg, instant)
        pg = pg or tab.CurPage or tab.Pages[1]
        local old = W.CurrentPage
        local changed = old ~= pg
        local dir = (old and pg.Seq < old.Seq) and -1 or 1
        for _, t in ipairs(W.Tabs) do
            for _, p in ipairs(t.Pages) do
                local on = (p == pg)
                if p.Side then p.Side.Visible = on end
                p.Tok = (p.Tok or 0) + 1 -- cancels any pending fade started by an earlier switch
                local tok = p.Tok
                if on then
                    p.Grp.Visible = true
                    if changed and not instant then
                        p.Grp.GroupTransparency = 1
                        p.Grp.Position = UDim2.new(0, 0, 0, 22 * dir)
                        task.delay(0.08, function()
                            if p.Tok ~= tok then return end
                            Tween(p.Grp, { GroupTransparency = 0, Position = UDim2.new() }, 0.4, Enum.EasingStyle.Quint)
                        end)
                    else
                        p.Grp.GroupTransparency = 0
                        p.Grp.Position = UDim2.new()
                    end
                elseif p == old and changed and not instant and p.Grp.Visible then
                    Tween(p.Grp, { GroupTransparency = 1, Position = UDim2.new(0, 0, 0, -14 * dir) }, 0.14, Enum.EasingStyle.Quad)
                    task.delay(0.15, function()
                        if p.Tok == tok then p.Grp.Visible = false end
                    end)
                else
                    p.Grp.Visible = false
                end
            end
        end
        W.Current, W.CurrentPage, tab.CurPage = tab, pg, pg
        ClosePopup()
        navAnimate = changed and not instant
        rebuildNav()
        navAnimate = false
    end
    W.SelectTab = selectTab

