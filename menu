-- edge: pass a number to get a hairline border (keystrokes use it). nil = no border at all.
local function Glass(parent, radius, transparency, edge)
    local f = New("Frame", {
        BackgroundColor3 = GLASS.Near, BackgroundTransparency = transparency or 0.15,
        BorderSizePixel = 0, ZIndex = 100, Parent = parent,
    })
    Corner(f, radius or 8)
    local s = New("UIStroke", {
        Color = WHITE, Transparency = edge or 1, Thickness = 1, Enabled = edge ~= nil,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = f,
    })
    return f, s
end

-- reliable text width: let a hidden TextLabel measure it (falls back to Measure)
local probe
local function TextW(text, size, font)
    local ok, w = pcall(function()
        if not (probe and probe.Parent) then
            probe = New("TextLabel", {
                BackgroundTransparency = 1, TextTransparency = 1, RichText = true,
                Size = UDim2.new(0, 600, 0, 30), Position = UDim2.new(0, -9999, 0, 0), Parent = Library.Gui,
            })
        end
        probe.FontFace, probe.TextSize, probe.Text = font, size + Library.TextBoost, text
        return probe.TextBounds.X
    end)
    if ok and w and w > 0 then return math.ceil(w) + 2 end
    return Measure(text, size, font)
end

