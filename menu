                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0, 17),
                    Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X, Parent = panel,
                })
                Corner(pillBtn, 10); Stroke(pillBtn, 0.72); Pad(pillBtn, 9, 0, 9, 0)
