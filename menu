-- objects created while a menu is being built (popups parented to Root); destroyed when the menu is rebuilt
function Library.Own(inst)
    if Library.ScopeObjs then Library.ScopeObjs[#Library.ScopeObjs + 1] = inst end
    return inst
end

function Library:SetMenuKey(name)
    name = tostring(name or ""):lower()
    local alias = {
        ins = "Insert", del = "Delete", enter = "Return", bksp = "Backspace", control = "LeftControl", rcontrol = "RightControl",
        shift = "LeftShift", rshift = "RightShift", alt = "LeftAlt", ralt = "RightAlt",
    }
    local want = alias[name]
    for _, kc in ipairs(Enum.KeyCode:GetEnumItems()) do
        if (want and kc.Name == want) or kc.Name:lower() == name then
            Library.MenuKey = kc
            return true
        end
    end
    return false
end

-- "..." button (three dots) used by the modern skin
local function DotsButton(parent)
    local b = New("TextButton", {
        Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(0, 22, 0, 20), Parent = parent,
    })
    local dots = {}
    for i = 1, 3 do
        local d = New("Frame", {
            BackgroundColor3 = Library.Theme.TextDim, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, (i - 2) * 6, 0.5, 0), Size = UDim2.new(0, 3, 0, 3), Parent = b,
        })
        Corner(d, 2)
        dots[i] = d
    end
    b.MouseEnter:Connect(function() for _, d in ipairs(dots) do Tween(d, { BackgroundColor3 = Library.Theme.Text }, 0.1) end end)
    b.MouseLeave:Connect(function() for _, d in ipairs(dots) do Tween(d, { BackgroundColor3 = Library.Theme.TextDim }, 0.1) end end)
    return b
end

local function BuildElements(container, prefix, skin)
    local E = {}
    local T = Library.Theme
    local modern = skin ~= nil

    local function flagOf(opts)
        return opts.Flag or ((prefix and (prefix .. "/") or "") .. (opts.Name or "?"))
    end

    local rowCount = 0
    local function Row(height)
        local r = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height), Parent = container })
        rowCount += 1
        if modern then
            if skin.Reveal then skin.Reveal() end
            if skin.OnRow then skin.OnRow(height) end
            if rowCount > 1 and not skin.NoDividers then
                New("Frame", {
                    BackgroundColor3 = T.Stroke, BackgroundTransparency = 0.93, BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 1), Parent = r,
                })
            end
        end
        return r
    end

    -- color picker
    local function AttachColorPicker(holder, flag, default, callback, noAlpha)
        default = default or WHITE
        local h, s, v = default:ToHSV()
        local a = 1 -- opacity (1 = solid). The slider below the picker shows it as "Transparency".
        local obj = { Value = default, Alpha = 1, Transparency = 0 }

        local swatch = New("TextButton", {
            Text = "", AutoButtonColor = false, BackgroundColor3 = default, Size = UDim2.new(0, 18, 0, 18), Parent = holder,
        })
        Corner(swatch, 6); Stroke(swatch, 0.85)

        local pop = New("CanvasGroup", {
            Visible = false, BackgroundColor3 = T.Popup, BackgroundTransparency = 0.08,
            Size = UDim2.new(0, 172, 0, 190), ZIndex = 200, Parent = Root,
        })
        Corner(pop, 10); Stroke(pop, 0.82)
        Shadow(pop, 10, { Spread = 10, Offset = 3, Strength = 0.4 })
        Library.Own(pop)

        local sv = New("Frame", {
            BackgroundColor3 = Color3.fromHSV(h, 1, 1), Position = UDim2.new(0, 10, 0, 10),
            Size = UDim2.new(1, -20, 0, 108), ZIndex = 201, Parent = pop,
        })
        Corner(sv, 6)
        local white = New("Frame", { BackgroundColor3 = WHITE, Size = UDim2.new(1, 0, 1, 0), ZIndex = 202, Parent = sv })
        Corner(white, 6)
        New("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }), Parent = white })
        local black = New("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.new(1, 0, 1, 0), ZIndex = 203, Parent = sv })
        Corner(black, 6)
        New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }), Parent = black })
        local svDot = New("Frame", { BackgroundColor3 = WHITE, Size = UDim2.new(0, 8, 0, 8), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 205, Parent = sv })
        Corner(svDot, 4); Stroke(svDot, 0.2, Color3.new(0, 0, 0))

        local hue = New("Frame", {
            BackgroundColor3 = WHITE, Position = UDim2.new(0, 10, 0, 130),
            Size = UDim2.new(1, -20, 0, 10), ZIndex = 201, Parent = pop,
        })
        Corner(hue, 5)
        local seq = {}
        for i = 0, 6 do seq[#seq + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(math.min(i / 6, 0.999), 1, 1)) end
        New("UIGradient", { Color = ColorSequence.new(seq), Parent = hue })
        local hueDot = New("Frame", { BackgroundColor3 = WHITE, Size = UDim2.new(0, 4, 1, 4), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 205, Parent = hue })
        Corner(hueDot, 2); Stroke(hueDot, 0.2, Color3.new(0, 0, 0))

        -- transparency slider (small, under the hue bar): left = solid, right = fully transparent
        local aBack = New("Frame", {
            BackgroundColor3 = Color3.fromRGB(74, 74, 82), Position = UDim2.new(0, 10, 0, 150),
            Size = UDim2.new(1, -20, 0, 8), ZIndex = 201, Parent = pop,
        })
        Corner(aBack, 4)
        -- tiny checkerboard so transparency is visible
        for cx = 0, 10 do
            local sq = New("Frame", {
                BackgroundColor3 = Color3.fromRGB(120, 120, 128), BorderSizePixel = 0, ZIndex = 202,
                Position = UDim2.new(cx / 11, 0, (cx % 2) * 0.5, 0), Size = UDim2.new(1 / 11, 0, 0.5, 0), Parent = aBack,
            })
        end
        local aBar = New("Frame", {
            BackgroundColor3 = default, Size = UDim2.new(1, 0, 1, 0), ZIndex = 203, Parent = aBack,
        })
        Corner(aBar, 4)
        New("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }), Parent = aBar })
        local aDot = New("Frame", { BackgroundColor3 = WHITE, Size = UDim2.new(0, 4, 1, 4), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 205, Parent = aBack })
        Corner(aDot, 2); Stroke(aDot, 0.2, Color3.new(0, 0, 0))
        local aLbl = New("TextLabel", {
            BackgroundTransparency = 1, Text = "Transparency 0%", TextColor3 = T.TextDim, TextSize = 10, FontFace = F_MED,
            TextXAlignment = TLEFT, Position = UDim2.new(0, 10, 0, 163), Size = UDim2.new(1, -20, 0, 16), ZIndex = 201, Parent = pop,
        })

        if noAlpha then -- colours that have no use for opacity (theme colours...) hide the Transparency slider
            aBack.Visible, aLbl.Visible = false, false
            pop.Size = UDim2.new(0, 172, 0, 152)
        end

        local function apply(fire)
            local c = Color3.fromHSV(h, s, v)
            obj.Value = c
            obj.Alpha, obj.Transparency = a, 1 - a
            swatch.BackgroundColor3 = c
            swatch.BackgroundTransparency = math.clamp(1 - a, 0, 0.8) -- never fully invisible, so it can still be clicked
            sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            svDot.Position = UDim2.new(s, 0, 1 - v, 0)
            hueDot.Position = UDim2.new(h, 0, 0.5, 0)
            aBar.BackgroundColor3 = c
            aDot.Position = UDim2.new(1 - a, 0, 0.5, 0)
            aLbl.Text = ("Transparency %d%%"):format(math.floor((1 - a) * 100 + 0.5))
            if flag then
                Library.Flags[flag] = c
                Library.Flags[flag .. "_Alpha"] = a            -- opacity: 1 = solid
                Library.Flags[flag .. "_Transparency"] = 1 - a -- Roblox style: 0 = solid
            end
            if fire and callback then task.spawn(callback, c, a) end
        end
        BindDrag(sv, function(p)
            s = math.clamp((p.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
            v = 1 - math.clamp((p.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
            apply(true)
        end)
        BindDrag(hue, function(p)
            h = math.clamp((p.X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X, 0, 1)
            apply(true)
        end)
        BindDrag(aBack, function(p)
            a = 1 - math.clamp((p.X - aBack.AbsolutePosition.X) / aBack.AbsoluteSize.X, 0, 1)
            apply(true)
        end)
        swatch.MouseButton1Click:Connect(function()
            if Library.Popup and Library.Popup.Frame == pop then ClosePopup() return end
            local sc, p = Library.Scale, swatch.AbsolutePosition - Root.AbsolutePosition
            local x = math.min(p.X, Gui.AbsoluteSize.X - 182 * sc)
            pop.Position = UDim2.new(0, x / sc, 0, (p.Y + 26 * sc) / sc)
            OpenPopup(pop, swatch)
            Shine(swatch, 6)
        end)
        function obj:Set(c, fire, alpha)
            h, s, v = c:ToHSV()
            if alpha ~= nil then a = math.clamp(tonumber(alpha) or 1, 0, 1) end
            apply(fire == true)
        end
        function obj:SetAlpha(alpha, fire) a = math.clamp(tonumber(alpha) or 1, 0, 1); apply(fire == true) end
        apply(false)
        if flag then Library.Options[flag] = obj end
        return obj
    end

    -- keybind pill
    local function AttachKeybind(holder, flag, default, onPress, onRelease, onChange)
        local obj = { Key = default or "none", Listening = false }
        local btn = New("TextButton", {
            Text = obj.Key, AutoButtonColor = false, BackgroundColor3 = T.Element, BackgroundTransparency = 0.4,
            TextColor3 = T.TextDim, TextSize = 11, FontFace = F_MED,
            Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X, Parent = holder,
        })
        Corner(btn, 10); Pad(btn, 10, 0, 10, 0); Stroke(btn, 0.85)
        -- plain (static) border while waiting for a key
        local ls = Stroke(btn, 0.35)
        ls.Enabled = false
        if flag then Library.Flags[flag] = obj.Key end

        local function set(k)
            obj.Key = k
            btn.Text = k
            if flag then Library.Flags[flag] = k end
            if onChange then task.spawn(onChange, k) end
            if Library.RefreshHotkeys then Library.RefreshHotkeys() end
        end
        btn.MouseButton1Click:Connect(function()
            obj.Listening = true
            Library.ListeningKeybind = obj
            ls.Enabled = true
            btn.Text = "..."
            btn.TextColor3 = T.Text
        end)
        Track(UIS.InputBegan:Connect(function(i, gp)
            if obj.Listening then
                if i.UserInputType == Enum.UserInputType.MouseButton1 and Inside(btn, Pt(i)) then return end
                local k = KeyName(i)
                if k then
                    obj.Listening = false
                    if Library.ListeningKeybind == obj then Library.ListeningKeybind = nil end
                    ls.Enabled = false
                    btn.TextColor3 = T.TextDim
                    if i.KeyCode == Enum.KeyCode.Escape or i.KeyCode == Enum.KeyCode.Backspace then k = "none" end
                    set(k)
                end
            elseif not gp and obj.Key ~= "none" and KeyName(i) == obj.Key and onPress then
                task.spawn(onPress)
            end
        end))
        Track(UIS.InputEnded:Connect(function(i)
            if not obj.Listening and obj.Key ~= "none" and KeyName(i) == obj.Key and onRelease then
                task.spawn(onRelease)
            end
        end))
        function obj:Set(k) set(k) end
        if flag then Library.Options[flag] = obj end
        return obj
    end

