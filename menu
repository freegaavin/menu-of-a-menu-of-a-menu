        saveBtn.Text = "Save config"
        if Library:SaveConfig(nm) then nameBox.Text = "" end
    end
    saveBtn.MouseButton1Click:Connect(function() Shine(saveBtn, 8, 0.6); doSave() end)
    nameBox.FocusLost:Connect(function(enter) if enter then doSave() end end)
    nameBox:GetPropertyChangedSignal("Text"):Connect(function()
        if saveArmed then saveArmed = false; saveBtn.Text = "Save config" end
    end)

    iconBtn(-10, "save", function() -- quick overwrite of the currently loaded config
        if Library.CurrentConfig then Library:SaveConfig(Library.CurrentConfig)
        else Library:Notify("Configs", "No config loaded - type a name below and press Save config", 3) end
    end)
