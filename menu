local GLASS = {
    Near = Color3.fromRGB(19, 19, 25),
    Text = Color3.fromRGB(224, 226, 230),
    Dim = Color3.fromRGB(150, 156, 162),
    KeyText = Color3.fromRGB(172, 175, 180),
